if (!file_exists("build")) { mkdir("build"); }
if (!file_exists("build/rendered")) { mkdir("build/rendered"); }
p = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
let mat = material().color(0.18, 0.62, 0.88);
for (i in range(0, 7)) {
  let x = float(i) - 3.0;
  scene.box(0.7, 0.7, 0.7, mat).position(x, 0.0, 0.0);
}
scene.camera(42.0, 0.0, 4.0, 10.0, 0.0, 0.0, 0.0);
scene.directional_light(-0.4, -1.0, -0.5, 0.72);
scene.fill_light(0.8, -0.2, 0.9, 0.42);
scene.ambient(0.24);
scene.background(0.04, 0.06, 0.1);
scene.render_png("build/loop-row.png", 480, 270);
end _lmcode_
out = "build/loop-row.dslb";
savedsl(p, "build/loop-row.dslb");

run = system ${dsl_cli(p)} --lmcode ${out};
if (run.code != 0) { println(str(run.stderr)); lm_exit(run.code); }
