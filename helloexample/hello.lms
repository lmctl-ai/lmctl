// description: Seed one provider and send a first prompt through its Lead.
// autorun-role: Lead provider=claude model=claude-sonnet-5-5
if (args.len() < 1) { lm_error("Usage: lmctl autorun https://lmctl.com/helloexample/hello.lms \"your prompt\""); lm_exit(2); }
file = path_join(Directory, "hello.lmctl");
for (n = 2; file_exists(file); n = n + 1) { file = path_join(Directory, f"hello{n}.lmctl"); }
provider = "@role(Lead.provider)";
model = "@role(Lead.model)";
text = f"""# Hello

_MEMBER_ alias=Lead provider={json_stringify(provider)} model={json_stringify(model)}
""";
write_file_exclusive(file, text);
println(f"Wrote {file}");
r = lm_seed(file);
require(r.status == "ok", f"Could not seed {file}");
r = lm_prompt(file, "Lead", args[0]);
require(r.status == "ok", "The Lead prompt failed");
println(r.reply);
println(f"Resume: {cmd_render(["lmctl", "terminal", file, "Lead"], "posix")}");
println(f"Prompt: {cmd_render(["lmctl", "prompt", file, "Lead", "your next prompt"], "posix")}");
if (!NonInteractive) {
  r = lm_terminal(file, "Lead");
  if (r.exit_code != 0) { lm_exit(r.exit_code); }
}
