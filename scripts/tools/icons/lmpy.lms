# lmpy icon: a compact numerical matrix on a rounded panel.
# Usage (see README.md): lmscript lmpy.lms OUT_DIR OUT.dslb, then lmcad --dsl OUT.dslb
out = ARGV.get(0, "build");
p = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
# --- shared icon look: identical in every icon script (render.sh --check verifies) ---
scene.background(0.17, 0.20, 0.27);
scene.directional_light(-0.5, -1.0, -0.6, 0.85);
scene.fill_light(0.8, -0.2, 0.9, 0.40);
scene.ambient(0.32);
scene.supersample(4);
let view_x = 0.36;
let view_y = 0.38;
let view_z = 0.85;
# --- end shared icon look ---
let panel = material().color(0.22, 0.31, 0.42).roughness(0.55);
let cell = material().color(0.39, 0.82, 0.73).roughness(0.4);
let accent = material().color(1.00, 0.76, 0.34).roughness(0.35);
let base = scene.box(2.3, 2.1, 0.35, panel);
base.fillet(0.12);
base.position(0.0, 0.0, -0.15);
for (row in range(0, 3)) {
  for (col in range(0, 3)) {
    if (row == 1 && col == 1) {
      scene.box(0.42, 0.42, 0.12, accent).position(float(col - 1) * 0.58, float(1 - row) * 0.58, 0.12);
    } else {
      scene.box(0.42, 0.42, 0.12, cell).position(float(col - 1) * 0.58, float(1 - row) * 0.58, 0.12);
    }
  }
}
let aim_x = -0.04;
let dist = 9.53;
let icon_zoom = 0.845;
let aim_y = 0.05;
# Logo: comfortable margins. Favicon sizes: the same view moved closer.
scene.camera(28.0, aim_x + view_x * dist, aim_y + view_y * dist, view_z * dist, aim_x, aim_y, 0.0);
scene.render_png(${out} + "/logo.png", 256, 256);
let near = dist * icon_zoom;
scene.camera(28.0, aim_x + view_x * near, aim_y + view_y * near, view_z * near, aim_x, aim_y, 0.0);
scene.render_png(${out} + "/icon.png", 64, 64);
scene.render_png(${out} + "/icon-32.png", 32, 32);
scene.render_png(${out} + "/icon-16.png", 16, 16);
end _lmcode_
savedsl(p, ARGV.get(1, "icon.dslb"));
