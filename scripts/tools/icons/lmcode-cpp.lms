# lmcode-cpp icon: two meshing gears (a runtime turning bytecode), teeth placed in loops.
# Usage (see README.md): lmscript lmcode-cpp.lms OUT_DIR OUT.dslb, then lmcad --dsl OUT.dslb
out = ARGV.get(0, "build");
p = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
# --- shared icon look: identical in every icon script (render.sh --check verifies) ---
scene.background(0.17, 0.20, 0.27);
scene.directional_light(-0.5, -1.0, -0.6, 0.85);
scene.fill_light(0.8, -0.2, 0.9, 0.40);
scene.ambient(0.32);
scene.supersample(4);
let view_x = 0.36;
let view_y = 0.38;
let view_z = 0.85;
# --- end shared icon look ---
let big = material().color(0.74, 0.62, 1.00).roughness(0.45);
let small = material().color(1.00, 0.70, 0.18).roughness(0.45);
# Two gears in one plane (axis Z) whose teeth interleave without touching:
# centers 2.03 apart along the -45 degree line (tip of one gear clears the
# rim of the other), the big gear shows a gap and the small gear a tooth on
# that line. Teeth are placed in a loop.
let theta = -0.7854;
for (g in range(0, 2)) {
  let r = 1.05;
  let teeth = 10;
  let cx = -0.62;
  let cy = 0.62;
  let m = big;
  let phase = theta + 3.14159265 / 10.0;
  if (g == 1) {
    r = 0.62;
    teeth = 6;
    cx = -0.62 + 2.03 * cos(theta);
    cy = 0.62 + 2.03 * sin(theta);
    m = small;
    phase = theta + 3.14159265;
  }
  let gear = scene.cylinder(r, 0.45, m).rotate(1.5708, 0.0, 0.0);
  for (t in range(0, teeth)) {
    let a = phase + float(t) * 6.2831853 / float(teeth);
    let tooth = scene.box(0.34, 0.26, 0.45, m).rotate(0.0, 0.0, a).position(cos(a) * (r + 0.12), sin(a) * (r + 0.12), 0.0);
    gear.union(tooth);
    tooth.visible(false);
  }
  let hole = scene.cylinder(r * 0.36, 1.0, m).rotate(1.5708, 0.0, 0.0);
  gear.cut(hole);
  hole.visible(false);
  gear.position(cx, cy, 0.0);
}
let aim_x = -0.059;
let dist = 10.06;
let icon_zoom = 0.845;
let aim_y = 0.205;
# Logo: comfortable margins. Favicon sizes: the same view moved closer
# (icon_zoom) so the symbol fills the 64/32/16 px tile.
scene.camera(28.0, aim_x + view_x * dist, aim_y + view_y * dist, view_z * dist, aim_x, aim_y, 0.0);
scene.render_png(${out} + "/logo.png", 256, 256);
let near = dist * icon_zoom;
scene.camera(28.0, aim_x + view_x * near, aim_y + view_y * near, view_z * near, aim_x, aim_y, 0.0);
scene.render_png(${out} + "/icon.png", 64, 64);
scene.render_png(${out} + "/icon-32.png", 32, 32);
scene.render_png(${out} + "/icon-16.png", 16, 16);
end _lmcode_
savedsl(p, ARGV.get(1, "icon.dslb"));
