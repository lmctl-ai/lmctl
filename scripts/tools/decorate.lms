import "roles.lms";
directories = join(sort(glob("tools/*/")), "|") + "|";
p = _dsl_ schema="lmhtml.dsl.json";
# Source-preserving pre formatting (kept identical in check/decorate).
# Locate the nth real element with the host tokenizer, not a text match alone:
# a comment or script may contain an identical-looking HTML snippet.
fn element_offset(source: string, tag: string, raw: string, ordinal: int) -> int {
  let start = 0;
  let found = -1;
  while (start < str_len(source) && found < 0) {
    let relative = str_find(str_substr(source, start, str_len(source)), raw);
    if (relative < 0) { break; }
    let candidate = start + relative;
    let prefix = str_substr(source, 0, candidate + str_len(raw));
    if (html.parse(prefix).source_elements(tag).len() == ordinal + 1) { found = candidate; }
    start = candidate + str_len(raw);
  }
  return found;
}
fn missing_separator(gap: string) -> bool {
  # Comments are invisible, including newlines inside a comment.
  let parsed = html.parse("<pre>x" + gap + "y</pre>");
  let text = parsed.select("pre").at(0).text();
  let visible = str_substr(text, 1, str_len(text) - 2);
  return parsed.select("*").len() == 4 && str_trim(visible) == "" && !str_contains(visible, "\n") && !str_contains(visible, "\r");
}
fn separate_commands(source: string, first: string, second: string) -> string {
  let result = source;
  let firsts = html.parse(source).source_elements(first);
  let seconds = html.parse(source).source_elements(second);
  for (i in range(0, firsts.len())) {
    for (j in range(0, seconds.len())) {
      let end = element_offset(result, first, firsts.at(i), i) + str_len(firsts.at(i));
      let start = element_offset(result, second, seconds.at(j), j);
      if (start >= end) {
        let gap = str_substr(result, end, start - end);
        if (missing_separator(gap)) {
          result = str_substr(result, 0, start) + "\n" + str_substr(result, start, str_len(result));
        }
      }
    }
  }
  return result;
}
fn format_pre(source: string) -> string {
  let result = separate_commands(source, "kbd", "samp");
  result = separate_commands(result, "samp", "kbd");
  let codes = html.parse(result).source_elements("code");
  for (i in range(0, codes.len())) {
    let raw = codes.at(i);
    let inner = html.parse(raw).source_inner("code");
    let trimmed = inner;
    while (str_starts_with(trimmed, "\n") || str_starts_with(trimmed, "\r\n")) {
      let n = 1;
      if (str_starts_with(trimmed, "\r\n")) { n = 2; }
      trimmed = str_substr(trimmed, n, str_len(trimmed));
    }
    while (str_ends_with(trimmed, "\n")) {
      let n = 1;
      if (str_ends_with(trimmed, "\r\n")) { n = 2; }
      trimmed = str_substr(trimmed, 0, str_len(trimmed) - n);
    }
    if (trimmed != inner) {
      let replacement = str_replace(raw, ">" + inner + "</", ">" + trimmed + "</");
      let start = element_offset(result, "code", raw, i);
      result = str_substr(result, 0, start) + replacement + str_substr(result, start + str_len(raw), str_len(result));
    }
  }
  let inner = html.parse(result).source_inner("pre");
  let trimmed = inner;
  while (str_starts_with(trimmed, "\n") || str_starts_with(trimmed, "\r\n")) {
    let n = 1;
    if (str_starts_with(trimmed, "\r\n")) { n = 2; }
    trimmed = str_substr(trimmed, n, str_len(trimmed));
  }
  while (str_ends_with(trimmed, "\n")) {
    let n = 1;
    if (str_ends_with(trimmed, "\r\n")) { n = 2; }
    trimmed = str_substr(trimmed, 0, str_len(trimmed) - n);
  }
  if (trimmed != inner) { result = str_replace(result, ">" + inner + "</", ">" + trimmed + "</"); }
  return result;
}
fn norm(value: string) -> string {
  let result = "";
  let space = false;
  for (i in range(0, str_len(value))) {
    let ch = str_substr(value, i, 1);
    if (ch == " " || ch == "\n" || ch == "\r" || ch == "\t") { space = str_len(result) > 0; }
    else { if (space) { result = result + " "; } result = result + ch; space = false; }
  }
  return result;
}
# Prefer a complete sentence within the target; otherwise retain whole words.
# A single oversized word is kept intact rather than silently mutilated.
fn excerpt(value: string, limit: int, sentences: bool) -> string {
  let result = norm(value);
  let prefix = str_text_prefix(result, limit);
  if (prefix != result) {
    let sentence = 0;
    let word = 0;
    for (i in range(0, str_len(prefix))) {
      let ch = str_substr(result, i, 1);
      let next = str_substr(result, i + 1, 1);
      if (ch == " ") { word = i; }
      if ((ch == "." || ch == "!" || ch == "?") && next == " ") { sentence = i + 1; }
    }
    if (sentences && sentence > 0) { result = str_substr(result, 0, sentence); }
    else {
      # Leave room for the ellipsis, including at an exact word boundary.
      prefix = str_text_prefix(result, limit - 1);
      word = 0;
      for (i in range(0, str_len(prefix))) { if (str_substr(prefix, i, 1) == " ") { word = i; } }
      if (str_substr(result, str_len(prefix), 1) == " ") { word = str_len(prefix); }
      if (word == 0) { word = str_find(result, " "); }
      if (word > 0) { result = str_substr(result, 0, word) + "…"; }
    }
  }
  return result;
}
fn escape(value: string) -> string {
  return str_replace(str_replace(str_replace(str_replace(str_replace(value, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), "\"", "&quot;"), "{{", "&#123;&#123;");
}
fn region(source: string, name: string) -> string {
  let begin_marker = "<!-- " + name + " -->";
  let end_marker = "<!-- /" + name + " -->";
  let offset = str_find(source, begin_marker);
  let start = offset + str_len(begin_marker);
  let end = str_find(source, end_marker);
  if (offset < 0 || end < start) {
    report.add("template", "scripts/tools/template.html", 0, "missing or invalid region: " + name);
    report.write_text(${ARGV[1]});
    report.fail_if_any();
  }
  return str_trim(str_substr(source, start, end - start));
}
fn basename(path: string) -> string {
  let slash = 0;
  for (i in range(0, str_len(path))) { if (str_substr(path, i, 1) == "/") { slash = i + 1; } }
  return str_substr(path, slash, str_len(path));
}
fn role(filename: string) -> string {
  let stem = str_substr(filename, 0, str_len(filename) - 5);
  let dash = str_find(stem, "-");
  if (dash >= 0) { stem = str_substr(stem, 0, dash); }
  return stem;
}
fn heading(page: Doc) -> string {
  let result = "";
  if (page.select("h1").len() > 0) { result = norm(page.select("h1").at(0).text()); }
  return result;
}
fn page_title(title: string, tool: string) -> string {
  let result = title;
  if (title != tool) { result = result + " — " + tool; }
  return result + " — lmctl.com tools";
}
fn summary(page: Doc) -> string {
  let paragraphs = page.select("main p");
  if (paragraphs.len() == 0) { paragraphs = page.select("body > p, body > :not(nav):not(footer) p"); }
  let result = "";
  if (paragraphs.len() > 0) { result = excerpt(paragraphs.at(0).text(), 160, true); }
  return result;
}
fn image_dimensions(source: string) -> string {
  let result = source;
  let images = html.parse(source).source_elements("img");
  for (i in range(0, images.len())) {
    let raw = images.at(i);
    let node = html.parse(raw).select("img").at(0);
    let src = node.attr("src");
    if (str_starts_with(src, "/tools/") && str_ends_with(str_lower(src), ".png") && html.link_exists(html.parse(""), src)) {
      if (!node.has_attr("width") || !node.has_attr("height")) {
        let size = html.png_size(str_substr(src, 1, str_len(src)));
        let attrs = "";
        if (!node.has_attr("width")) { attrs = attrs + " width=\"" + str(size.width()) + "\""; }
        if (!node.has_attr("height")) { attrs = attrs + " height=\"" + str(size.height()) + "\""; }
        let close = str_len(raw) - 1;
        if (str_substr(raw, close - 1, 1) == "/") { close = close - 1; }
        let replacement = str_substr(raw, 0, close) + attrs + str_substr(raw, close, str_len(raw));
        let offset = element_offset(result, "img", raw, i);
        result = str_substr(result, 0, offset) + replacement + str_substr(result, offset + str_len(raw), str_len(result));
      }
    }
  }
  return result;
}
fn content(page: Doc) -> string {
  # Retain original source, not serialized DOM. Quotes, entities, comments,
  # spacing and even invalid author attributes stay byte-for-byte intact.
  let root = "";
  if (page.source_outer("html") != "") { root = "html"; }
  if (page.source_outer("body") != "") { root = "body"; }
  let result = page.source_inner(root, "!doctype head nav footer");
  if (page.select("main").len() == 0) { result = "<main>" + result + "</main>"; }
  else { result = str_trim(result); }
  let pres = html.parse(result).source_elements("pre");
  for (i in range(0, pres.len())) {
    let raw = pres.at(i);
    let replacement = format_pre(raw);
    if (replacement != raw) {
      let start = element_offset(result, "pre", raw, i);
      result = str_substr(result, 0, start) + replacement + str_substr(result, start + str_len(raw), str_len(result));
    }
  }
  return result;
}
fn page_description(page: Doc) -> string {
  let result = summary(page);
  let meta = page.select("head meta[name='description']");
  if (meta.len() > 0 && norm(meta.at(0).attr("content")) != "") {
    let previous = norm(meta.at(0).attr("content"));
    let paragraphs = page.select("main p");
    if (paragraphs.len() == 0) { paragraphs = page.select("body > p, body > :not(nav):not(footer) p"); }
    let old_generated = "";
    if (paragraphs.len() > 0) { old_generated = str_trim(str_text_prefix(norm(paragraphs.at(0).text()), 160)); }
    if (previous != old_generated) { result = excerpt(previous, 160, true); }
  }
  return result;
}
# Optional artwork is derived solely from conventional paths.
fn asset_exists(path: string) -> bool {
  return html.link_exists(html.parse(""), path);
}
fn favicon(path: string) -> string {
  let result = "";
  if (asset_exists(path)) { result = "<link rel=\"icon\" type=\"image/png\" href=\"" + escape(path) + "\">"; }
  return result;
}
fn logo(path: string, alt: string) -> string {
  let result = "";
  if (asset_exists(path)) { result = "<figure><img src=\"" + escape(path) + "\" alt=\"" + escape(alt) + "\"></figure>"; }
  return result;
}
fn render(layout: string, nav: string, footer: string, body: string, title: string, description: string) -> string {
  # Replace CONTENT last: author text containing template markers is literal.
  let result = str_replace(layout, "{{TITLE}}", escape(title));
  result = str_replace(result, "{{DESCRIPTION}}", escape(description));
  result = str_replace(result, "{{NAV}}", nav);
  result = str_replace(result, "{{FOOTER}}", footer);
  return html.parse(image_dimensions(str_replace(result, "{{CONTENT}}", body) + "\n")).normalize();
}
fn differences(page: Doc, result: string) -> string {
  let wanted = html.parse(result);
  let changed = "";
  if (page.doctype() != "html") { changed = changed + "doctype "; }
  if (page.select("html").at(0).attr("lang") != "en") { changed = changed + "lang "; }
  if (page.select("main").len() != 1) { changed = changed + "main wrapper "; }
  if (page.select("head").at(0).hash() != wanted.select("head").at(0).hash()) { changed = changed + "head/title/description "; }
  if (page.select("nav").len() != 1) { changed = changed + "nav "; }
  else { if (page.select("nav").at(0).hash() != wanted.select("nav").at(0).hash()) { changed = changed + "nav "; } }
  if (page.select("footer").len() != 1) { changed = changed + "footer "; }
  else { if (page.select("footer").at(0).hash() != wanted.select("footer").at(0).hash()) { changed = changed + "footer "; } }
  if (changed == "") { changed = "shell formatting"; }
  return "missing or outdated: " + str_trim(changed);
}
fn store(path: string, result: string, before: string, check: bool, what: string) -> void {
  if (result != before) {
    report.add("decorate", path, 0, what + "; run npm run decorate:tools");
    if (!check) { html.save(result, path); }
  }
}
let check = ${ARGV[2]} == "--check";
let template_source = html.load("scripts/tools/template.html").source();
let required_regions = "layout|tool-nav|tool-footer|site-nav|site-footer|tool-index|site-index|";
while (str_find(required_regions, "|") >= 0) {
  let end = str_find(required_regions, "|");
  region(template_source, str_substr(required_regions, 0, end));
  required_regions = str_substr(required_regions, end + 1, str_len(required_regions));
}
let layout = region(template_source, "layout");
let site_layout = str_replace(layout, "{{ICON}}", favicon("/tools/img/icon.png"));
# Refuse malformed authored source before changing any file; common shells are
# replaceable, but token repair must never silently rewrite authored content.
for (page in html.load_dir(".", "tools/**/*.html", "")) {
  if (basename(page.path()) == "index.html") { continue; }
  for (problem in page.markup_errors()) { report.add("markup", page.path(), 0, problem); }
}
report.write_text(${ARGV[1]});
report.fail_if_any();
let role_data = ${role_table};
let tool_dirs = ${directories};
let tool_links = "";
let root_probe = html.parse("");
while (str_find(tool_dirs, "|") >= 0) {
  let separator = str_find(tool_dirs, "|");
  let directory = str_substr(tool_dirs, 0, separator);
  tool_dirs = str_substr(tool_dirs, separator + 1, str_len(tool_dirs));
  if (directory == "") { continue; }
  let pages = html.load_dir(directory, "*.html", "");
  let count = 0;
  for (page in pages) { if (basename(page.path()) != "index.html") { count = count + 1; } }
  if (count == 0) { continue; }
  let tool = basename(directory);
  let icon_path = "/tools/" + tool + "/img/icon.png";
  let tool_layout = str_replace(layout, "{{ICON}}", favicon(icon_path));
  let repo = "https://github.com/lmctl-ai/" + tool;
  if (html.link_exists(root_probe, "/" + directory + "/repo.txt")) { repo = str_trim(html.load(directory + "/repo.txt").source()); }
  let footer = str_replace(region(template_source, "tool-footer"), "{{REPO}}", escape(repo));
  footer = str_replace(footer, "{{REPO_LABEL}}", escape(str_replace(repo, "https://", "")));
  let links = "";
  let used_labels = "\nTools\nOverview\n";
  let roles = role_data;
  while (str_find(roles, "|") >= 0) {
    let end = str_find(roles, "|");
    let entry = str_substr(roles, 0, end);
    roles = str_substr(roles, end + 1, str_len(roles));
    let equal = str_find(entry, "=");
    let name = str_substr(entry, 0, equal);
    let label = str_substr(entry, equal + 1, str_len(entry));
    for (page in pages) {
      let filename = basename(page.path());
      if (filename == "index.html" || role(filename) != name) { continue; }
      let text = label;
      if (filename != name + ".html") { text = label + ": " + excerpt(heading(page), 80, false); }
      while (str_contains(used_labels, "\n" + text + "\n")) {
        text = text + " (" + str_substr(filename, 0, str_len(filename) - 5) + ")";
      }
      used_labels = used_labels + text + "\n";
      links = links + "<li><a href=\"/tools/" + escape(tool) + "/" + escape(filename) + "\">" + escape(text) + "</a></li>\n";
    }
  }
  let nav = str_replace(region(template_source, "tool-nav"), "{{TOOL}}", escape(tool));
  nav = str_replace(nav, "{{PAGE_LINKS}}", links);
  # Authored indexes are overviews. A marked generated index remains a fallback
  # for newly added tools that have not written an overview yet.
  let index_exists = html.link_exists(root_probe, "/" + directory + "/index.html");
  let index_page = html.parse("");
  if (index_exists) { index_page = html.load(directory + "/index.html"); }
  let authored_index = index_exists && !str_contains(index_page.source(), "<!-- generated tool index -->");
  let tool_title = "";
  let tool_summary = "";
  if (authored_index) { tool_title = heading(index_page); tool_summary = summary(index_page); }
  for (page in pages) {
    if (basename(page.path()) == "index.html") { continue; }
    if (tool_title == "") { tool_title = heading(page); tool_summary = summary(page); }
    let result = render(tool_layout, nav, footer, content(page), page_title(heading(page), tool), page_description(page));
    store(page.path(), result, page.source(), check, differences(page, result));
  }
  let index_body = "";
  let index_description = tool_summary;
  let index_before = "";
  if (authored_index) {
    index_body = content(index_page);
    index_description = page_description(index_page);
    index_before = index_page.source();
  } else {
    index_body = "<!-- generated tool index -->\n" + str_replace(region(template_source, "tool-index"), "{{TOOL_TITLE}}", escape(tool_title));
    index_body = str_replace(index_body, "{{LOGO}}", logo("/tools/" + tool + "/img/logo.png", tool + " logo"));
    index_body = str_replace(index_body, "{{SUMMARY}}", escape(tool_summary));
    index_body = str_replace(index_body, "{{REPO}}", escape(repo));
    index_body = str_replace(index_body, "{{PAGE_LINKS}}", links);
    if (index_exists) { index_before = index_page.source(); }
  }
  let index_result = render(tool_layout, nav, footer, index_body, page_title(tool_title, tool), index_description);
  let index_diff = "missing or stale generated tool index";
  if (authored_index) { index_diff = differences(index_page, index_result); }
  store(directory + "/index.html", index_result, index_before, check, index_diff);
  let icon = "";
  if (asset_exists(icon_path)) { icon = "<img src=\"" + escape(icon_path) + "\" alt=\"\">"; }
  tool_links = tool_links + "<li>" + icon + "<a href=\"/tools/" + escape(tool) + "/\">" + escape(tool_title) + "</a> — " + escape(tool_summary) + "</li>\n";
}
for (page in html.load_dir("tools", "*.html", "*/*.html")) {
  if (basename(page.path()) == "index.html") { continue; }
  store(page.path(), render(site_layout, region(template_source, "site-nav"), region(template_source, "site-footer"), content(page), heading(page) + " — lmctl.com tools", page_description(page)), page.source(), check, "missing or outdated site document shell");
}
let site_content = str_replace(region(template_source, "site-index"), "{{TOOL_LINKS}}", tool_links);
site_content = str_replace(site_content, "{{LOGO}}", logo("/tools/img/tools.png", "lmctl tools"));
let old_index = "";
let probe = html.parse("");
if (html.link_exists(probe, "/tools/index.html")) { old_index = html.load("tools/index.html").source(); }
store("tools/index.html", render(site_layout, region(template_source, "site-nav"), region(template_source, "site-footer"), site_content, "Tools — lmctl.com", "Small command-line tools from lmctl, with skill pages for LLM agents and task-specific documentation."), old_index, check, "missing or stale generated tools index");
report.write_text(${ARGV[1]});
if (check) { report.fail_if_any(); }
end _dsl_
savedsl(p, ARGV[0]);
