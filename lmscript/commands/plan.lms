// plan.lms -- write a teamfile from a request form.
//   lmctl script plan.lms request.json
//
// { "dir": "./backend",
//   "name": "backend.lmctl",
//   "members": [ { "alias": "Lead",     "provider": "<your-provider>", "model": "<a-model>" },
//                { "alias": "Reviewer", "provider": "<your-provider>", "model": "<a-model>" } ] }
//
// Safe to edit: everything. This is a sample, not a service -- reshape it for the job.

// read the request form
if (len(args) < 1) { println("usage: lmctl script plan.lms <request.json>"); lm_exit(2); }
if (!file_exists(args[0])) { lm_error("no request form at " + args[0]); lm_exit(2); }
req = json_parse_safe(read_file(args[0]), null);
if (req == null) { lm_error(args[0] + " is not valid JSON"); lm_exit(2); }
dir = getstr(req, "dir");
if (dir == "") { lm_error("missing required field: dir"); lm_exit(2); }
name = getstr(req, "name");
if (name == "") { name = "team.lmctl"; }
members = getlist(req, "members");
target = dir + "/" + name;

// build the lmctl plan command
argv = ["lmctl", "plan", dir, "--output", target, "--non-interactive", "--no-seed"];
for (i = 0; i < len(members); i = i + 1) {
  m = members[i];
  spec = getstr(m, "alias") + ":" + getstr(m, "provider");
  model = getstr(m, "model");
  if (model != "") { spec = spec + ":" + model; }
  push(argv, "--member"); push(argv, spec);
}

// run it
r = system(argv, 300000);
if (getnum(r, "code", 1) != 0) {
  lm_error("plan failed: " + trim(getstr(r, "stderr") + getstr(r, "stdout")));
  lm_exit(70);
}

// report where the teamfile landed
println("planned: " + target);
