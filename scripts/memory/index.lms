# Generate or refresh the note list in DIR/index.html (content-only profile).
# ARGV: bytecode output, report output, DIR, check flag ("1" = only report).
# The list sits between two marker comments; everything else in index.html is
# authored and kept as it is. Notes are listed alphabetically, archive/ last.
dir = ARGV[2];
check_only = ARGV[3] == "1";
require(dir != "" && file_exists(dir), "usage: index.lms OUT.dslb REPORT DIR CHECK");
fn note_list(dir) {
  top = [];
  archived = [];
  for (path in sort(glob(dir + "/*.html"))) {
    name = basename(path);
    if (name != "index.html" && regex_test(name, "^[a-z0-9]+(-[a-z0-9]+)*\\.html$")) { push(top, name); }
  }
  for (path in sort(glob(dir + "/archive/*.html"))) {
    name = basename(path);
    if (regex_test(name, "^[a-z0-9]+(-[a-z0-9]+)*\\.html$")) { push(archived, "archive/" + name); }
  }
  return join(concat(top, archived), "|") + (len(top) + len(archived) > 0 ? "|" : "");
}
notes = note_list(dir);
index_exists = file_exists(dir + "/index.html");

p = _dsl_ schema="lmhtml.dsl.json";
fn escape(text: string) -> string {
  return str_replace(str_replace(str_replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;");
}
fn one_line(text: string) -> string {
  let out = str_replace(str_replace(str_replace(text, "\r", " "), "\n", " "), "\t", " ");
  while (str_contains(out, "  ")) { out = str_replace(out, "  ", " "); }
  return str_trim(out);
}
fn summary(page: Doc) -> string {
  let paragraphs = page.select("body > p");
  let text = "";
  if (paragraphs.len() > 0) { text = one_line(paragraphs.at(0).text()); }
  # Prefer the last sentence end within 160 characters, else a word boundary
  # plus an ellipsis; a single oversized word stays intact.
  let out = text;
  if (str_len(text) > 160) {
    let head = str_substr(text, 0, 160);
    let cut = -1;
    let at = 0;
    while (str_find(str_substr(head, at, str_len(head)), ". ") >= 0) {
      at = at + str_find(str_substr(head, at, str_len(head)), ". ") + 1;
      cut = at;
    }
    if (cut > 40) {
      out = str_substr(text, 0, cut);
    } else {
      let space = -1;
      at = 0;
      while (str_find(str_substr(head, at, str_len(head)), " ") >= 0) {
        at = at + str_find(str_substr(head, at, str_len(head)), " ") + 1;
        space = at - 1;
      }
      if (space > 0) { out = str_substr(text, 0, space) + "…"; }
    }
  }
  return out;
}

let base = ${dir};
let begin = "<!-- begin note list: generated by scripts/memory/run.sh index; edit the notes, not this list -->";
let finish = "<!-- end note list -->";
let region = begin + "\n<ul>\n";
let pending = ${notes};
while (str_find(pending, "|") >= 0) {
  let rel = str_substr(pending, 0, str_find(pending, "|"));
  pending = str_substr(pending, str_find(pending, "|") + 1, str_len(pending));
  let page = html.load(base + "/" + rel);
  let title = one_line(page.select("title").at(0).text());
  let line = "<li><a href=\"" + rel + "\">" + escape(title) + "</a>";
  let about = summary(page);
  if (about != "") { line = line + ": " + escape(about); }
  region = region + line + "</li>\n";
}
region = region + "</ul>\n" + finish;

let path = base + "/index.html";
let current = "";
let updated = "";
if (${index_exists}) {
  current = html.load(path).source();
  let start = str_find(current, begin);
  let stop = str_find(current, finish);
  if (start >= 0 && stop > start) {
    updated = str_substr(current, 0, start) + region + str_substr(current, stop + str_len(finish), str_len(current));
  } else {
    let body_end = str_find(current, "</body>");
    if (body_end < 0) {
      report.add("memory", path, 0, "index: no </body> to place the note list before");
    } else {
      updated = str_substr(current, 0, body_end) + region + "\n" + str_substr(current, body_end, str_len(current));
    }
  }
} else {
  updated = "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Durable memory</title>\n</head>\n<body>\n<h1>Durable memory</h1>\n<p>Notes kept for people and agents working on this project. Read this index first, then the notes it lists.</p>\n" + region + "\n</body>\n</html>\n";
}
if (updated != "" && updated != current) {
  if (${check_only}) {
    report.add("memory", path, 0, "index: note list is missing or stale; run scripts/memory/run.sh index " + base);
  } else {
    html.save(updated, path);
  }
}
report.write_text(${ARGV[1]});
report.fail_if_any();
end _dsl_
savedsl(p, ARGV[0]);
