program = _lmcode_ schema="todo-handler.schema.json";
@todo
fn selectTodo() -> void implements DemoHandler {
  dom_set_html("demo-output", "<ul id='todo-list' class='todo-list'></ul>");
  dom_set_text("status", "Ready to fetch the static todo list.");
}
@svg
fn drawSvg() -> void implements DemoHandler {
  dom_set_html("demo-output",
    "<svg class='diagram' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 640 260' role='img' aria-label='Browser selection flows through LMCode to the DOM'>" +
    "<rect x='25' y='85' width='170' height='90' rx='14' fill='#263d75' stroke='#8dd8c5' stroke-width='2'/>" +
    "<rect x='235' y='85' width='170' height='90' rx='14' fill='#263d75' stroke='#8dd8c5' stroke-width='2'/>" +
    "<rect x='445' y='85' width='170' height='90' rx='14' fill='#263d75' stroke='#8dd8c5' stroke-width='2'/>" +
    "<path d='M195 130 H235 M405 130 H445' stroke='#8dd8c5' stroke-width='4'/>" +
    "<path d='M225 120 L235 130 L225 140 M435 120 L445 130 L435 140' fill='none' stroke='#8dd8c5' stroke-width='4'/>" +
    "<g fill='#edf2ff' font-family='sans-serif' font-size='19' text-anchor='middle'>" +
    "<text x='110' y='125'>HTML select</text><text x='110' y='151'>@svg</text>" +
    "<text x='320' y='125'>LMCode</text><text x='320' y='151'>DemoHandler</text>" +
    "<text x='530' y='125'>DOM host</text><text x='530' y='151'>dom_set_html</text>" +
    "</g><text x='320' y='225' fill='#b6c2df' font-family='sans-serif' font-size='16' text-anchor='middle'>This SVG was inserted by an LMCode host call</text></svg>");
  dom_set_text("status", "SVG diagram rendered by LMCode @svg through dom_set_html");
}
@canvas
fn drawCanvas() -> void implements DemoHandler {
  dom_set_html("demo-output", "<canvas id='diagram-canvas' class='diagram' width='640' height='260' role='img' aria-label='Browser selection flows through LMCode to canvas drawing host functions'></canvas>");
  canvas_clear("diagram-canvas", 640, 260);
  canvas_fill_rect("diagram-canvas", 25, 85, 170, 90, "#263d75");
  canvas_fill_rect("diagram-canvas", 235, 85, 170, 90, "#263d75");
  canvas_fill_rect("diagram-canvas", 445, 85, 170, 90, "#263d75");
  canvas_stroke_line("diagram-canvas", 195, 130, 235, 130, "#8dd8c5", 4);
  canvas_stroke_line("diagram-canvas", 405, 130, 445, 130, "#8dd8c5", 4);
  canvas_fill_text("diagram-canvas", "HTML select", 110, 120, "#edf2ff", "19px sans-serif");
  canvas_fill_text("diagram-canvas", "@canvas", 110, 148, "#edf2ff", "19px sans-serif");
  canvas_fill_text("diagram-canvas", "LMCode", 320, 120, "#edf2ff", "19px sans-serif");
  canvas_fill_text("diagram-canvas", "DemoHandler", 320, 148, "#edf2ff", "19px sans-serif");
  canvas_fill_text("diagram-canvas", "Canvas host", 530, 120, "#edf2ff", "19px sans-serif");
  canvas_fill_text("diagram-canvas", "fill_rect + text", 530, 148, "#edf2ff", "19px sans-serif");
  canvas_fill_text("diagram-canvas", "This diagram was painted by LMCode host calls", 320, 225, "#b6c2df", "16px sans-serif");
  dom_set_text("status", "Canvas diagram rendered by LMCode @canvas through drawing host functions");
}
@webgl
fn drawWebGl() -> void implements DemoHandler {
  dom_set_html("demo-output", "<canvas id='webgl-canvas' class='diagram' width='640' height='320' role='img' aria-label='A depth-tested three-dimensional cube rendered with WebGL'></canvas>");
  webgl_draw("webgl-canvas");
  dom_set_text("status", "3D cube rendered by LMCode @webgl through the WebGL host function");
}
@animation
fn startAnimation() -> void implements DemoHandler {
  dom_set_html("demo-output", "<button id='animation-toggle' type='button'>Pause animation</button><canvas id='animation-canvas' class='diagram' width='640' height='300' role='img' aria-label='Interactive animation running; use the Pause animation button to control it'></canvas>");
  animation_start("animation-canvas");
  dom_set_text("status", "Animation running via requestAnimationFrame. Move the pointer; use Pause animation to stop.");
}
@data
fn selectDataDrawing() -> void implements DemoHandler {
  dom_set_html("demo-output", "<canvas id='data-canvas' class='diagram' width='640' height='320' role='img' aria-label='Drawing loaded from a JSON draw document'></canvas>");
  dom_set_text("status", "Loading JSON drawing…");
}
@draw
fn drawCommand(command: string, x: int, y: int, w: int, h: int, color: string, text: string) -> void implements DrawCommand {
  if (command == "rect") {
    canvas_fill_rect("data-canvas", x, y, w, h, color);
  } else if (command == "line") {
    canvas_stroke_line("data-canvas", x, y, w, h, color, 3);
  } else if (command == "circle") {
    canvas_fill_circle("data-canvas", x, y, w, color);
  } else if (command == "text") {
    canvas_fill_text("data-canvas", text, x, y, color, "18px sans-serif");
  }
}
@render
fn render(title: string, completed: bool) -> string implements TodoHandler {
  let marker = "○ ";
  if (completed) {
    marker = "✓ ";
  }
  return marker + title;
}
end _lmcode_
