if (!file_exists("build")) { mkdir("build"); }
if (!file_exists("build/rendered")) { mkdir("build/rendered"); }
p = _lmcode_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(960, 300, "#101820");
scene.rect(60.0, 100.0, 220.0, 100.0, "#1e3247");
scene.rect(370.0, 100.0, 220.0, 100.0, "#1e3247");
scene.rect(680.0, 100.0, 220.0, 100.0, "#1e3247");
scene.text(170.0, 145.0, 20.0, "1. Check", "#dbe7f3").set_attr("text-anchor", "middle");
scene.text(170.0, 174.0, 14.0, "syntax and names", "#9db4c8").set_attr("text-anchor", "middle");
scene.text(480.0, 145.0, 20.0, "2. Preflight", "#dbe7f3").set_attr("text-anchor", "middle");
scene.text(480.0, 174.0, 14.0, "preview planned effects", "#9db4c8").set_attr("text-anchor", "middle");
scene.text(790.0, 145.0, 20.0, "3. Run", "#dbe7f3").set_attr("text-anchor", "middle");
scene.text(790.0, 174.0, 14.0, "perform real effects", "#9db4c8").set_attr("text-anchor", "middle");
let first = scene.line(280.0, 150.0, 362.0, 150.0, "#f5c16c", 2.5);
scene.path("M 370.0 150.0 L 358.0 143.0 L 358.0 157.0 Z", "#f5c16c", "none", 1.0);
let second = scene.line(590.0, 150.0, 672.0, 150.0, "#f5c16c", 2.5);
scene.path("M 680.0 150.0 L 668.0 143.0 L 668.0 157.0 Z", "#f5c16c", "none", 1.0);
scene.text(60.0, 60.0, 25.0, "One script, three passes", "#dbe7f3");
scene.text(60.0, 250.0, 14.0, "A dry preflight previews effects; it is not a security sandbox.", "#9db4c8");
scene.render_png("build/rendered/script-lifecycle.png", 960, 300, 1);
end _lmcode_
savedsl(p, "build/rendered/script-lifecycle.dslb");
run = system ${dsl_cli(p)} --dsl build/rendered/script-lifecycle.dslb;
if (run.code != 0) { println(str(run.stderr)); lm_exit(run.code); }
println("compiled script lifecycle diagram");
