out = ARGV[0];
p = _dsl_ schema="lmcad.dsl.json";
let frame_count = 240;
let render_width = 480;
let render_height = 270;
let blue = material().color(0.18, 0.60, 0.94).specular(0.18).shininess(22.0);
let teal = material().color(0.14, 0.78, 0.68).specular(0.20).shininess(24.0);
let gold = material().color(0.98, 0.68, 0.20).specular(0.22).shininess(26.0);
let violet = material().color(0.62, 0.45, 0.94).specular(0.18).shininess(22.0);
let coral = material().color(0.96, 0.38, 0.28).specular(0.18).shininess(22.0);
let green = material().color(0.28, 0.80, 0.48).specular(0.18).shininess(22.0);

# Shared look block: keep identical in all four homepage storyboards.
scene.background(0.035, 0.055, 0.10);
scene.directional_light(-0.55, -1.0, -0.45, 0.82);
scene.fill_light(0.7, -0.15, 0.8, 0.28);
scene.ambient(0.19);
scene.supersample(1);

# A person defines the request. The checklist is a panel with three marks.
let human_left = scene.sphere(0.70, teal).position(-8.0, 0.9, 0.0);
let human_left_body = scene.cylinder(0.48, 1.4, teal).position(-8.0, -0.45, 0.0);
let checklist = scene.box(1.25, 1.45, 0.22, gold).position(-6.1, 0.1, 0.2);
let mark0 = scene.box(0.58, 0.08, 0.08, blue).position(-6.1, 0.5, 0.38);
let mark1 = scene.box(0.58, 0.08, 0.08, blue).position(-6.1, 0.1, 0.38);
let mark2 = scene.box(0.58, 0.08, 0.08, blue).position(-6.1, -0.3, 0.38);

# The Lead coordinates two members in the middle of the workflow.
let lead = scene.sphere(0.76, gold).position(0.0, 0.4, 0.0);
let coder = scene.sphere(0.56, blue).position(-2.5, -1.5, 0.0);
let reviewer = scene.sphere(0.56, violet).position(2.5, -1.5, 0.0);
let left_link = scene.box(2.6, 0.08, 0.12, blue).position(-1.3, -0.6, -0.7);
let right_link = scene.box(2.6, 0.08, 0.12, violet).position(1.3, -0.6, -0.7);

# A second person receives and reviews the finished result.
let human_right = scene.sphere(0.70, teal).position(8.0, 0.9, 0.0).visible(false);
let human_right_body = scene.cylinder(0.48, 1.4, teal).position(8.0, -0.45, 0.0).visible(false);
let result = scene.box(0.72, 0.72, 0.5, green).position(0.0, 0.4, 0.4).visible(false);
let work_packet = scene.sphere(0.24, coral);
let review_packet = scene.sphere(0.24, gold);
let camera = scene.camera(42.0, 0.0, 0.0, 16.5, 0.0, 0.0, 0.0);
for (frame in range(0, frame_count)) {
  let t = float(frame) / float(frame_count - 1);
  let request_t = ease(clamp(t / 0.32, 0.0, 1.0));
  let checklist_x = lerp(-6.1, -2.6, request_t);
  checklist.position(checklist_x, 0.1, 0.2);
  mark0.position(checklist_x, 0.5, 0.38);
  mark1.position(checklist_x, 0.1, 0.38);
  mark2.position(checklist_x, -0.3, 0.38);
  checklist.visible(t < 0.40); mark0.visible(t < 0.40); mark1.visible(t < 0.40); mark2.visible(t < 0.40);
  human_left.visible(t < 0.40); human_left_body.visible(t < 0.40);
  human_right.visible(t > 0.86); human_right_body.visible(t > 0.86);

  let activity = 0.10 * sin(t * 18.8496);
  coder.position(-2.5, -1.5 + activity, 0.0);
  reviewer.position(2.5, -1.5 - activity, 0.0);
  lead.position(0.0, 0.4 + 0.06 * cos(t * 18.8496), 0.0);

  let message_cycle = float(frame % 72) / 71.0;
  if (message_cycle < 0.5) {
    let message_t = ease(message_cycle * 2.0);
    work_packet.position(lerp(-2.5, 0.0, message_t), lerp(-1.5, 0.4, message_t), 0.75);
    review_packet.position(lerp(0.0, 2.5, message_t), lerp(0.4, -1.5, message_t), 0.78);
  } else {
    let message_t = ease((message_cycle - 0.5) * 2.0);
    work_packet.position(lerp(0.0, -2.5, message_t), lerp(0.4, -1.5, message_t), 0.75);
    review_packet.position(lerp(2.5, 0.0, message_t), lerp(-1.5, 0.4, message_t), 0.78);
  }

  let result_t = ease(clamp((t - 0.70) / 0.30, 0.0, 1.0));
  result.position(lerp(0.0, 6.7, result_t), 0.45, 0.65);
  result.visible(t > 0.70);
  scene.render_png("frames/level-3/frame-" + str(frame) + ".png", render_width, render_height);
}
end _dsl_
savedsl(p, out);
