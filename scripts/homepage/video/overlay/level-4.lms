out = ARGV[0];
p = _lmcode_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1280, 720, "#00000000");
let cover_navy = scene.linear_gradient("cover_navy", 0.0, 0.0, 1.0, 1.0);
cover_navy.stop(0.0, "#111f32"); cover_navy.stop(0.55, "#152438"); cover_navy.stop(1.0, "#203750");
scene.rect(0.0, 0.0, 1280.0, 720.0, "url(#cover_navy)");
let cover_edge_gradient = scene.linear_gradient("cover_edge", 0.0, 0.0, 1.0, 0.0);
cover_edge_gradient.stop(0.0, "#08132170"); cover_edge_gradient.stop(0.22, "#08132100");
cover_edge_gradient.stop(0.78, "#08132100"); cover_edge_gradient.stop(1.0, "#08132170");
scene.rect(0.0, 0.0, 1280.0, 720.0, "url(#cover_edge)");
let cover_vertical_gradient = scene.linear_gradient("cover_vertical", 0.0, 0.0, 0.0, 1.0);
cover_vertical_gradient.stop(0.0, "#08132160"); cover_vertical_gradient.stop(0.2, "#08132100");
cover_vertical_gradient.stop(0.8, "#08132100"); cover_vertical_gradient.stop(1.0, "#08132160");
scene.rect(0.0, 0.0, 1280.0, 720.0, "url(#cover_vertical)");
let gold = "#f5c16c";
let paper = "#f5f8fb";
let dim = "#b9c8d8";
let navy = "#091625";
let blue = "#75a9ff";
let teal = "#74d8cf";
let violet = "#c4a6ff";
let coral = "#ff997c";
let green = "#82d48d";

# Keep the same title treatment as the other homepage levels.
scene.rect(36.0, 28.0, 1208.0, 112.0, "#091625E8");
scene.rect(36.0, 28.0, 9.0, 112.0, gold);
scene.text(72.0, 106.0, 42.0, "Turn a repeatable job into automation", paper);
let badge = scene.rect(1050.0, 54.0, 160.0, 56.0, "#263d54E8"); badge.set_attr("rx", "14");
let badge_text = scene.text(1068.0, 94.0, 34.0, "LEVEL 4", gold); badge_text.set_attr("font-weight", "700");

# Brainstorm, script and team cards remain in one readable row; top bars show the active stage.
let brain = scene.rect(54.0, 164.0, 368.0, 208.0, navy); brain.set_attr("rx", "18");
scene.rect(54.0, 164.0, 8.0, 208.0, teal);
let brain_stage = scene.rect(68.0, 164.0, 340.0, 7.0, teal);
let brain_title = scene.text(78.0, 207.0, 34.0, "BRAINSTORM", teal); brain_title.set_attr("font-weight", "700");
scene.text(78.0, 246.0, 30.0, "YOU + ARCHITECTS", paper);
let you = scene.rect(76.0, 278.0, 96.0, 58.0, "#173344"); you.set_attr("rx", "12");
let you_text = scene.text(94.0, 317.0, 28.0, "YOU", paper);
let arch1 = scene.rect(180.0, 278.0, 108.0, 58.0, "#173344"); arch1.set_attr("rx", "12");
let arch1_text = scene.text(188.0, 317.0, 26.0, "ARCH A", paper);
let arch2 = scene.rect(296.0, 278.0, 108.0, 58.0, "#173344"); arch2.set_attr("rx", "12");
let arch2_text = scene.text(304.0, 317.0, 26.0, "ARCH B", paper);

let script = scene.rect(462.0, 164.0, 282.0, 208.0, navy); script.set_attr("rx", "18");
let script_accent = scene.rect(462.0, 164.0, 8.0, 208.0, gold);
let script_stage = scene.rect(476.0, 164.0, 254.0, 7.0, gold);
scene.text(434.0, 278.0, 42.0, ">", gold);
let script_title = scene.text(488.0, 207.0, 36.0, "SCRIPT", gold); script_title.set_attr("font-weight", "700");
let script_subtitle = scene.text(488.0, 246.0, 28.0, "AUTOMATION", paper);
let code_back = scene.rect(492.0, 270.0, 222.0, 74.0, "#12283b");
let code1 = scene.rect(514.0, 286.0, 1.0, 7.0, blue);
let code2 = scene.rect(514.0, 302.0, 1.0, 7.0, violet);
let code3 = scene.rect(514.0, 318.0, 1.0, 7.0, teal);

let teams = scene.rect(788.0, 164.0, 438.0, 208.0, navy); teams.set_attr("rx", "18");
scene.rect(788.0, 164.0, 8.0, 208.0, blue);
let teams_stage = scene.rect(802.0, 164.0, 410.0, 7.0, blue);
scene.text(750.0, 278.0, 42.0, ">", gold);
let teams_title = scene.text(814.0, 207.0, 34.0, "SPAWN TEAMS", blue); teams_title.set_attr("font-weight", "700");
let coder = scene.rect(812.0, 254.0, 118.0, 82.0, "#142b43"); coder.set_attr("rx", "12");
let coder_name = scene.text(827.0, 288.0, 30.0, "CODER", blue);
let coder_role = scene.text(827.0, 320.0, 27.0, "WORK", paper);
let reviewer = scene.rect(938.0, 254.0, 142.0, 82.0, "#282342"); reviewer.set_attr("rx", "12");
let reviewer_name = scene.text(948.0, 288.0, 27.0, "REVIEWER", violet);
let reviewer_role = scene.text(963.0, 320.0, 27.0, "REVIEW", paper);
let qa_team = scene.rect(1090.0, 254.0, 112.0, 82.0, "#39271f"); qa_team.set_attr("rx", "12");
let qa_name = scene.text(1118.0, 288.0, 30.0, "QA", coral);
let qa_role = scene.text(1110.0, 320.0, 27.0, "CHECK", paper);

# Leave a clear label lane above the return loop; its arrow points back into WORK.
scene.text(54.0, 400.0, 32.0, "WORKFLOW", dim);
let return_path = scene.path("M 500 472 L 500 450 L 250 450 L 250 456", "#00000000", coral, 8.0);
let return_arrow = scene.path("M 241 456 L 250 472 L 259 456", "#00000000", coral, 8.0);
let fail_label = scene.text(220.0, 438.0, 32.0, "FAIL / FIX", coral);

let rail = scene.rect(54.0, 548.0, 1172.0, 10.0, "#38516a");
let work_box = scene.rect(54.0, 472.0, 224.0, 156.0, "#0d2034"); work_box.set_attr("rx", "16");
scene.rect(54.0, 472.0, 224.0, 8.0, blue);
let work_text = scene.text(78.0, 525.0, 36.0, "WORK", blue); work_text.set_attr("font-weight", "700");
scene.text(78.0, 600.0, 30.0, "Build", paper);
let review_box = scene.rect(291.0, 472.0, 224.0, 156.0, "#171a32"); review_box.set_attr("rx", "16");
scene.rect(291.0, 472.0, 224.0, 8.0, violet);
let review_text = scene.text(315.0, 525.0, 36.0, "REVIEW", violet); review_text.set_attr("font-weight", "700");
scene.text(315.0, 600.0, 30.0, "Revise", paper);
let qa_box = scene.rect(528.0, 472.0, 224.0, 156.0, "#30231f"); qa_box.set_attr("rx", "16");
scene.rect(528.0, 472.0, 224.0, 8.0, coral);
let qa_text = scene.text(552.0, 525.0, 36.0, "QA", coral); qa_text.set_attr("font-weight", "700");
scene.text(552.0, 600.0, 30.0, "Check", paper);
let accept_box = scene.rect(765.0, 472.0, 224.0, 156.0, "#142a29"); accept_box.set_attr("rx", "16");
scene.rect(765.0, 472.0, 224.0, 8.0, green);
let accept_text = scene.text(789.0, 525.0, 36.0, "ACCEPT", green); accept_text.set_attr("font-weight", "700");
scene.text(789.0, 600.0, 30.0, "Pass", paper);
let check_light = scene.rect(915.0, 577.0, 58.0, 38.0, green); check_light.set_attr("rx", "19");
let check_mark = scene.text(927.0, 604.0, 28.0, "OK", "#091625"); check_mark.set_attr("font-weight", "700");
let deliver_box = scene.rect(1002.0, 472.0, 224.0, 156.0, "#142a29"); deliver_box.set_attr("rx", "16");
scene.rect(1002.0, 472.0, 224.0, 8.0, green);
let deliver_text = scene.text(1026.0, 525.0, 36.0, "DELIVER", green); deliver_text.set_attr("font-weight", "700");
scene.text(1026.0, 600.0, 30.0, "Artifact", paper);

# A shaded 3D-like token travels the rail; a small finished file lands in DELIVER.
let token_gradient = scene.linear_gradient("token_gold", 0.0, 0.0, 1.0, 1.0);
token_gradient.stop(0.0, "#fff0ad"); token_gradient.stop(0.48, "#f5c16c"); token_gradient.stop(1.0, "#bc7d36");
let token_shadow = scene.circle(0.0, 0.0, 17.0, "#081321");
let token = scene.circle(0.0, 0.0, 15.0, "url(#token_gold)");
let token_glint = scene.circle(0.0, 0.0, 4.0, "#fff4c9");
let artifact_gradient = scene.linear_gradient("artifact_green", 0.0, 0.0, 1.0, 1.0);
artifact_gradient.stop(0.0, "#bbf2c1"); artifact_gradient.stop(1.0, "#4ba66a");
let artifact_shadow = scene.rect(1154.0, 541.0, 42.0, 50.0, "#081321"); artifact_shadow.set_attr("rx", "6");
let artifact = scene.rect(1150.0, 536.0, 42.0, 50.0, "url(#artifact_green)"); artifact.set_attr("rx", "6");
let artifact_line1 = scene.rect(1158.0, 549.0, 25.0, 3.0, "#e9fff0");
let artifact_line2 = scene.rect(1158.0, 558.0, 19.0, 3.0, "#e9fff0");
let artifact_line3 = scene.rect(1158.0, 567.0, 23.0, 3.0, "#e9fff0");

for (i in range(0, 240)) {
  let brain_on = "0";
  if (i < 40 || i >= 216) { brain_on = "1"; }
  brain_stage.set_attr("opacity", brain_on);
  let you_opacity = "0"; let arch1_opacity = "0"; let arch2_opacity = "0";
  if (i >= 5 && i < 216) { you_opacity = "1"; }
  if (i >= 11 && i < 216) { arch1_opacity = "1"; }
  if (i >= 17 && i < 216) { arch2_opacity = "1"; }
  if (i >= 216 && i < 222) { you_opacity = str(1.0 - float(i - 216) / 6.0); }
  if (i >= 222 && i < 228) { arch1_opacity = str(1.0 - float(i - 222) / 6.0); }
  if (i >= 228 && i < 234) { arch2_opacity = str(1.0 - float(i - 228) / 6.0); }
  you.set_attr("opacity", you_opacity); you_text.set_attr("opacity", you_opacity);
  arch1.set_attr("opacity", arch1_opacity); arch1_text.set_attr("opacity", arch1_opacity);
  arch2.set_attr("opacity", arch2_opacity); arch2_text.set_attr("opacity", arch2_opacity);
  let script_visible = "0";
  if (i >= 40 && i < 208) { script_visible = "1"; }
  if (i >= 208 && i < 216) { script_visible = str(1.0 - float(i - 208) / 8.0); }
  let script_on = "0";
  if (i >= 40 && i < 82) { script_on = "1"; }
  script.set_attr("opacity", script_visible); script_accent.set_attr("opacity", script_visible);
  script_stage.set_attr("opacity", script_on); script_title.set_attr("opacity", script_visible); script_subtitle.set_attr("opacity", script_visible); code_back.set_attr("opacity", script_visible);
  let line1_width = 0.01; let line2_width = 0.01; let line3_width = 0.01;
  if (i >= 40) { line1_width = 132.0; }
  if (i >= 50) { line2_width = 174.0; }
  if (i >= 60) { line3_width = 102.0; }
  if (i >= 40 && i < 50) { line1_width = 0.01 + 132.0 * float(i - 40) / 10.0; }
  if (i >= 50 && i < 60) { line2_width = 0.01 + 174.0 * float(i - 50) / 10.0; }
  if (i >= 60 && i < 70) { line3_width = 0.01 + 102.0 * float(i - 60) / 10.0; }
  code1.set_attr("width", str(line1_width)); code2.set_attr("width", str(line2_width)); code3.set_attr("width", str(line3_width));
  code1.set_attr("opacity", script_visible); code2.set_attr("opacity", script_visible); code3.set_attr("opacity", script_visible);
  let teams_on = "0";
  if (i >= 82 && i < 111) { teams_on = "1"; }
  teams_stage.set_attr("opacity", teams_on);
  let coder_opacity = "0"; let reviewer_opacity = "0"; let qa_opacity = "0";
  if (i >= 84 && i < 208) { coder_opacity = "1"; }
  if (i >= 208 && i < 216) { coder_opacity = str(1.0 - float(i - 208) / 8.0); }
  if (i >= 92 && i < 208) { reviewer_opacity = "1"; }
  if (i >= 208 && i < 216) { reviewer_opacity = str(1.0 - float(i - 208) / 8.0); }
  if (i >= 100 && i < 208) { qa_opacity = "1"; }
  if (i >= 208 && i < 216) { qa_opacity = str(1.0 - float(i - 208) / 8.0); }
  coder.set_attr("opacity", coder_opacity); coder_name.set_attr("opacity", coder_opacity); coder_role.set_attr("opacity", coder_opacity);
  reviewer.set_attr("opacity", reviewer_opacity); reviewer_name.set_attr("opacity", reviewer_opacity); reviewer_role.set_attr("opacity", reviewer_opacity);
  qa_team.set_attr("opacity", qa_opacity); qa_name.set_attr("opacity", qa_opacity); qa_role.set_attr("opacity", qa_opacity);

  let show_token = "0";
  let token_x = 166.0; let token_y = 560.0;
  if (i >= 104 && i < 124) { show_token = "1"; token_x = lerp(166.0, 403.0, float(i - 104) / 20.0); }
  if (i >= 124 && i < 130) { show_token = "1"; token_x = 403.0; }
  if (i >= 130 && i < 134) { show_token = "1"; token_x = lerp(403.0, 500.0, float(i - 130) / 4.0); }
  if (i >= 134 && i < 139) { show_token = "1"; token_x = 500.0; token_y = lerp(560.0, 455.0, float(i - 134) / 5.0); }
  if (i >= 139 && i < 153) { show_token = "1"; token_x = lerp(500.0, 250.0, float(i - 139) / 14.0); token_y = 455.0; }
  if (i >= 153 && i < 159) { show_token = "1"; token_x = 250.0; token_y = lerp(455.0, 560.0, float(i - 153) / 6.0); }
  if (i >= 159 && i < 172) { show_token = "1"; token_x = lerp(166.0, 403.0, float(i - 159) / 13.0); }
  if (i >= 172 && i < 180) { show_token = "1"; token_x = lerp(403.0, 640.0, float(i - 172) / 8.0); }
  if (i >= 180 && i < 190) { show_token = "1"; token_x = lerp(640.0, 877.0, float(i - 180) / 10.0); }
  if (i >= 190 && i < 198) { show_token = "1"; token_x = lerp(877.0, 1114.0, float(i - 190) / 8.0); }
  let loop_opacity = "0.60";
  if (i >= 130 && i < 159) { loop_opacity = "1"; }
  return_path.set_attr("opacity", loop_opacity); return_arrow.set_attr("opacity", loop_opacity); fail_label.set_attr("opacity", loop_opacity);
  token_shadow.set_attr("cx", str(token_x + 2.0)); token_shadow.set_attr("cy", str(token_y + 6.0)); token_shadow.set_attr("opacity", show_token);
  token.set_attr("cx", str(token_x)); token.set_attr("cy", str(token_y)); token.set_attr("opacity", show_token);
  token_glint.set_attr("cx", str(token_x - 5.0)); token_glint.set_attr("cy", str(token_y - 6.0)); token_glint.set_attr("opacity", show_token);
  let accepted = "0";
  if (i >= 185 && i < 216) { accepted = "1"; }
  check_light.set_attr("opacity", accepted); check_mark.set_attr("opacity", accepted);
  let artifact_opacity = "0";
  if (i >= 198 && i < 228) { artifact_opacity = "1"; }
  if (i >= 228 && i < 239) { artifact_opacity = str(1.0 - float(i - 228) / 11.0); }
  artifact_shadow.set_attr("opacity", artifact_opacity); artifact.set_attr("opacity", artifact_opacity);
  artifact_line1.set_attr("opacity", artifact_opacity); artifact_line2.set_attr("opacity", artifact_opacity); artifact_line3.set_attr("opacity", artifact_opacity);
  scene.render_png("build/rendered/overlay-" + str(i) + ".png", 1280, 720, 1);
}
end _lmcode_
savedsl(p, out);
