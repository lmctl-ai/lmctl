{
  "name": "lmctl-website",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for lmctl.",
  "scripts": {
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "start": "docusaurus start",
    "check:tools": "bash scripts/tools/run.sh check",
    "check:lmscript-site": "bash scripts/lmscript-site/check.sh",
    "build:onboarding-catalogs": "node scripts/build-onboarding-catalogs.mjs",
    "check:onboarding-catalogs": "node scripts/build-onboarding-catalogs.mjs --check",
  "check:homepage": "bash scripts/homepage/video/test-hash-files.sh && bash scripts/tools/run.sh homepage-videos",
    "check:tools:selftest": "bash scripts/tools/selftest.sh",
    "decorate:tools": "bash scripts/tools/run.sh decorate",
    "pull:tools": "python3 scripts/tools/pull-tools.py",
    "test:pull:tools": "python3 scripts/tools/test-pull-tools.py && python3 scripts/tools/test-pull-books.py && python3 scripts/tools/test-book-media.py",
    "sync:tool-examples": "bash scripts/tools/sync-example-book.sh",
    "test:redirect": "node tests/infra/lmctl-www-redirect.test.mjs",
    "build:skills": "bash scripts/tools/run.sh skills",
    "check:skills": "bash scripts/tools/run.sh skills --check",
    "check:skills:selftest": "bash scripts/tools/skills-selftest.sh",
    "check:memory": "bash scripts/memory/run.sh check durable-memory",
    "check:memory:selftest": "bash scripts/memory/selftest.sh",
    "build:memory-web": "bash scripts/memory/run.sh web durable-memory build/memory-web",
    "build:memory-index": "bash scripts/memory/run.sh index durable-memory"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@easyops-cn/docusaurus-search-local": "^0.50.0",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0"
  }
}
