out = ARGV[0];
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1280, 720, "#00000000");
let gold = "#f5c16c";
let paper = "#f5f8fb";
let bar = scene.rect(36.0, 28.0, 1208.0, 112.0, "#091625E8");
let stripe = scene.rect(36.0, 28.0, 9.0, 112.0, gold);
let title = scene.text(72.0, 106.0, 44.0, "Know your agents by name", paper);
let badge = scene.rect(1050.0, 54.0, 160.0, 56.0, "#263d54E8"); badge.set_attr("rx", "14");
let badge_text = scene.text(1068.0, 94.0, 34.0, "LEVEL 1", gold); badge_text.set_attr("font-weight", "700");
let row0 = scene.rect(64.0, 250.0, 288.0, 60.0, "#0a1828E8"); row0.set_attr("rx", "12");
let row1 = scene.rect(64.0, 438.0, 288.0, 60.0, "#0a1828E8"); row1.set_attr("rx", "12");
let row2 = scene.rect(64.0, 610.0, 288.0, 60.0, "#0a1828E8"); row2.set_attr("rx", "12");
let lead = scene.text(84.0, 294.0, 40.0, "LEAD TEAM", "#74d8cf");
let coder = scene.text(84.0, 482.0, 40.0, "CODER TEAM", gold);
let review = scene.text(84.0, 654.0, 40.0, "REVIEW TEAM", "#c4a6ff");
let running_box = scene.rect(980.0, 460.0, 264.0, 138.0, "#0a1828E8"); running_box.set_attr("rx", "14");
let running = scene.text(1000.0, 507.0, 40.0, "RUNNING", "#74d8cf"); running.set_attr("font-weight", "700");
let usage_label = scene.text(1000.0, 551.0, 32.0, "USAGE", paper); usage_label.set_attr("font-weight", "700");
let usage_back = scene.rect(1000.0, 565.0, 214.0, 22.0, "#31475c"); usage_back.set_attr("rx", "8");
let usage = scene.rect(1000.0, 565.0, 8.0, 22.0, gold); usage.set_attr("rx", "8");
for (i in range(0, 240)) {
  let show = "0";
  if (i >= 62) { show = "1"; }
  row0.set_attr("opacity", show); row1.set_attr("opacity", show); row2.set_attr("opacity", show);
  lead.set_attr("opacity", show); coder.set_attr("opacity", show); review.set_attr("opacity", show);
  let running_show = "0";
  if (i >= 95) { running_show = "1"; }
  running_box.set_attr("opacity", running_show); running.set_attr("opacity", running_show);
  usage_label.set_attr("opacity", running_show); usage_back.set_attr("opacity", running_show); usage.set_attr("opacity", running_show);
  let width = 214.0;
  if (i < 95) { width = 8.0; } else if (i < 180) { width = 8.0 + float(i - 95) * 2.42; }
  usage.set_attr("width", str(width));
  scene.render_png("build/rendered/overlay-" + str(i) + ".png", 1280, 720, 1);
}
end _dsl_
savedsl(p, out);
