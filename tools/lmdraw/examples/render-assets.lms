out = ARGV.len() > 0 ? ARGV[0] : "build/rendered/svg-assets";
if (!file_exists("build")) { mkdir("build"); }
if (!file_exists("build/rendered")) { mkdir("build/rendered"); }
if (!file_exists("assets")) { mkdir("assets"); }
if (!file_exists("assets/quickrun-0e2232fcea9f2111.svg")) { write_file_exclusive("assets/quickrun-0e2232fcea9f2111.svg", "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"360\" height=\"320\" viewBox=\"0 0 360 320\" role=\"img\" aria-labelledby=\"title desc\">\n  <title id=\"title\">Four rising levels of agent automation</title>\n  <desc id=\"desc\">Four compact steps rise from hands-on turns to automation. Your role at each level is written on the step, from every turn to a final review.</desc>\n  <rect id=\"svg-mobile\" x=\"3\" y=\"3\" width=\"354\" height=\"314\" rx=\"16\" fill=\"#152438\" stroke=\"#526a7e\"/>\n  <path d=\"M28 234H32V282H32M172 282H181V212H190M265 181V160H180V142H170M95 111V90H180V76H190M340 76H351V25\" fill=\"none\" stroke=\"#f5c16c\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  <text x=\"6\" y=\"215\" font-family=\"system-ui, sans-serif\" font-size=\"11px\" font-weight=\"600\" fill=\"#dce7f0\">You start</text>\n  <circle cx=\"18\" cy=\"234\" r=\"10\" fill=\"#f5c16c\"/><circle cx=\"18\" cy=\"231\" r=\"2.6\" fill=\"#152438\"/><path d=\"M13 239c1-4 9-4 10 0\" fill=\"none\" stroke=\"#152438\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n  <g><rect x=\"32\" y=\"251\" width=\"140\" height=\"62\" rx=\"8\" fill=\"#31475c\" fill-opacity=\".9\" stroke=\"#6fbdb4\" stroke-width=\"1.5\"/><text x=\"42\" y=\"272\" font-family=\"system-ui, sans-serif\" font-size=\"12px\" font-weight=\"700\" fill=\"#f5f8fb\">L1 \u00b7 Know sessions</text><text x=\"42\" y=\"294\" font-family=\"system-ui, sans-serif\" font-size=\"11px\" font-weight=\"600\" fill=\"#dce7f0\">You: every turn</text></g>\n  <g><rect x=\"190\" y=\"181\" width=\"150\" height=\"62\" rx=\"8\" fill=\"#31475c\" fill-opacity=\".9\" stroke=\"#6fbdb4\" stroke-width=\"1.5\"/><text x=\"200\" y=\"202\" font-family=\"system-ui, sans-serif\" font-size=\"12px\" font-weight=\"700\" fill=\"#f5f8fb\">L2 \u00b7 Coordinate</text><text x=\"200\" y=\"224\" font-family=\"system-ui, sans-serif\" font-size=\"11px\" font-weight=\"600\" fill=\"#dce7f0\">You: in the loop</text></g>\n  <g><rect x=\"20\" y=\"111\" width=\"150\" height=\"62\" rx=\"8\" fill=\"#31475c\" fill-opacity=\".9\" stroke=\"#6fbdb4\" stroke-width=\"1.5\"/><text x=\"30\" y=\"132\" font-family=\"system-ui, sans-serif\" font-size=\"12px\" font-weight=\"700\" fill=\"#f5f8fb\">L3 \u00b7 Delegate</text><text x=\"30\" y=\"153\" font-family=\"system-ui, sans-serif\" font-size=\"11px\" font-weight=\"600\" fill=\"#dce7f0\">You: start and end</text></g>\n  <g><rect x=\"190\" y=\"41\" width=\"150\" height=\"70\" rx=\"8\" fill=\"#31475c\" fill-opacity=\".9\" stroke=\"#6fbdb4\" stroke-width=\"1.5\"/><text x=\"200\" y=\"61\" font-family=\"system-ui, sans-serif\" font-size=\"12px\" font-weight=\"700\" fill=\"#f5f8fb\">L4 \u00b7 Automate</text><text x=\"200\" y=\"81\" font-family=\"system-ui, sans-serif\" font-size=\"11px\" font-weight=\"600\" fill=\"#dce7f0\">You: brainstorm</text><text x=\"200\" y=\"99\" font-family=\"system-ui, sans-serif\" font-size=\"11px\" font-weight=\"600\" fill=\"#dce7f0\">and verdict</text></g>\n  <circle cx=\"342\" cy=\"25\" r=\"9\" fill=\"#f5c16c\"/><circle cx=\"342\" cy=\"22\" r=\"2.4\" fill=\"#152438\"/><path d=\"M337 30c1-4 9-4 10 0\" fill=\"none\" stroke=\"#152438\" stroke-width=\"2\" stroke-linecap=\"round\"/><text x=\"331\" y=\"13\" text-anchor=\"end\" font-family=\"system-ui, sans-serif\" font-size=\"11px\" font-weight=\"600\" fill=\"#dce7f0\">You review</text>\n</svg>\n"); }
if (!file_exists("assets/quickrun-6df1a5bc02229890.svg")) { write_file_exclusive("assets/quickrun-6df1a5bc02229890.svg", "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"240\" height=\"150\" viewBox=\"0 0 240 150\" role=\"img\" aria-labelledby=\"t d\">\n  <title id=\"t\">Agents coordinate through a Lead</title><desc id=\"d\">A Lead connects coder and reviewer members; Claude and Codex provider badges identify the sessions.</desc>\n  <rect id=\"svg-team\" x=\"5\" y=\"5\" width=\"230\" height=\"140\" rx=\"14\" fill=\"#152438\" fill-opacity=\".9\" stroke=\"#526a7e\" stroke-width=\"2\"/>\n  <path d=\"M120 61v23M62 84h116M62 84v14m116-14v14\" fill=\"none\" stroke=\"#72c6bd\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n  <rect x=\"82\" y=\"25\" width=\"76\" height=\"36\" rx=\"9\" fill=\"#31475c\" stroke=\"#f5c16c\" stroke-width=\"2\"/><text x=\"120\" y=\"48\" fill=\"#f5f8fb\" text-anchor=\"middle\" font-family=\"Noto Sans,sans-serif\" font-size=\"13\" font-weight=\"700\">LEAD</text>\n  <rect x=\"24\" y=\"98\" width=\"76\" height=\"30\" rx=\"8\" fill=\"#31475c\" stroke=\"#72c6bd\"/><text x=\"40\" y=\"117\" fill=\"#f5f8fb\" text-anchor=\"start\" font-family=\"Noto Sans,sans-serif\" font-size=\"10\" font-weight=\"700\">CODER</text><circle cx=\"88\" cy=\"113\" r=\"8\" fill=\"#152438\" stroke=\"#88a8ef\"/><text x=\"88\" y=\"116\" text-anchor=\"middle\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"6\" font-weight=\"700\">CX</text>\n  <rect x=\"140\" y=\"98\" width=\"76\" height=\"30\" rx=\"8\" fill=\"#31475c\" stroke=\"#f5c16c\"/><text x=\"151\" y=\"117\" fill=\"#f5f8fb\" text-anchor=\"start\" font-family=\"Noto Sans,sans-serif\" font-size=\"9\" font-weight=\"700\">REVIEW</text><circle cx=\"207\" cy=\"113\" r=\"8\" fill=\"#152438\" stroke=\"#f5c16c\"/><text x=\"207\" y=\"116\" text-anchor=\"middle\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"6\" font-weight=\"700\">CL</text>\n</svg>\n"); }
if (!file_exists("assets/quickrun-82367c8317669db3.svg")) { write_file_exclusive("assets/quickrun-82367c8317669db3.svg", "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"240\" height=\"150\" viewBox=\"0 0 240 150\" role=\"img\" aria-labelledby=\"t d\">\n  <title id=\"t\">Human sets the task and reviews the outcome</title><desc id=\"d\">A person sends the goal to a Lead and provider team, then reviews the returned result.</desc>\n  <rect id=\"svg-delegate\" x=\"5\" y=\"5\" width=\"230\" height=\"140\" rx=\"14\" fill=\"#152438\" fill-opacity=\".9\" stroke=\"#526a7e\" stroke-width=\"2\"/>\n  <circle cx=\"36\" cy=\"63\" r=\"19\" fill=\"#f5c16c\"/><circle cx=\"36\" cy=\"58\" r=\"5\" fill=\"#152438\"/><path d=\"M25 75c2-11 20-11 22 0\" fill=\"none\" stroke=\"#152438\" stroke-width=\"4\" stroke-linecap=\"round\"/><text x=\"36\" y=\"105\" text-anchor=\"middle\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"10\" font-weight=\"700\">DEFINE</text>\n  <path d=\"M61 63h27m-7-7 7 7-7 7M163 63h17m-7-7 7 7-7 7\" fill=\"none\" stroke=\"#f5c16c\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  <rect x=\"91\" y=\"38\" width=\"68\" height=\"50\" rx=\"9\" fill=\"#31475c\" stroke=\"#72c6bd\" stroke-width=\"2\"/><path d=\"M124 49v20M110 69h28m-28 0v8m28-8v8\" fill=\"none\" stroke=\"#f5f8fb\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><circle cx=\"110\" cy=\"79\" r=\"4\" fill=\"#72c6bd\"/><circle cx=\"124\" cy=\"79\" r=\"4\" fill=\"#f5c16c\"/><circle cx=\"138\" cy=\"79\" r=\"4\" fill=\"#8aa8ed\"/>\n  <circle cx=\"204\" cy=\"63\" r=\"19\" fill=\"#f5c16c\"/><circle cx=\"204\" cy=\"58\" r=\"5\" fill=\"#152438\"/><path d=\"M194 74c2-9 18-9 20 0\" fill=\"none\" stroke=\"#152438\" stroke-width=\"4\" stroke-linecap=\"round\"/><text x=\"204\" y=\"105\" text-anchor=\"middle\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"10\" font-weight=\"700\">REVIEW</text>\n</svg>\n"); }
if (!file_exists("assets/quickrun-b9aabc71d76d0334.svg")) { write_file_exclusive("assets/quickrun-b9aabc71d76d0334.svg", "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"240\" height=\"150\" viewBox=\"0 0 240 150\" role=\"img\" aria-labelledby=\"t d\">\n  <title id=\"t\">Named provider sessions</title><desc id=\"d\">Sessions grouped by team and role with status, history and usage indicators.</desc>\n  <rect id=\"svg-sessions\" x=\"5\" y=\"5\" width=\"230\" height=\"140\" rx=\"14\" fill=\"#152438\" fill-opacity=\".9\" stroke=\"#526a7e\" stroke-width=\"2\"/>\n  <text x=\"20\" y=\"27\" fill=\"#f5c16c\" font-family=\"Noto Sans,sans-serif\" font-size=\"12\" font-weight=\"700\">TEAM \u00b7 PRODUCT</text>\n  <rect x=\"18\" y=\"38\" width=\"204\" height=\"27\" rx=\"6\" fill=\"#31475c\" fill-opacity=\".9\"/><circle cx=\"32\" cy=\"51\" r=\"5\" fill=\"#f5c16c\"/><text x=\"44\" y=\"55\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"12\" font-weight=\"700\">Lead</text><rect x=\"164\" y=\"44\" width=\"46\" height=\"15\" rx=\"7\" fill=\"#405d78\"/><text x=\"187\" y=\"55\" fill=\"#e4eef8\" text-anchor=\"middle\" font-family=\"Noto Sans,sans-serif\" font-size=\"9\" font-weight=\"700\">CLAUDE</text>\n  <rect x=\"18\" y=\"70\" width=\"204\" height=\"27\" rx=\"6\" fill=\"#31475c\" fill-opacity=\".9\"/><circle cx=\"32\" cy=\"83\" r=\"5\" fill=\"#88a8ef\"/><text x=\"44\" y=\"87\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"12\" font-weight=\"700\">Coder</text><rect x=\"164\" y=\"76\" width=\"46\" height=\"15\" rx=\"7\" fill=\"#405d78\"/><text x=\"187\" y=\"87\" fill=\"#e4eef8\" text-anchor=\"middle\" font-family=\"Noto Sans,sans-serif\" font-size=\"9\" font-weight=\"700\">CODEX</text>\n  <path d=\"M20 117h52m9 0h52m9 0h52\" stroke=\"#f5c16c\" stroke-width=\"5\" stroke-linecap=\"round\"/><text x=\"20\" y=\"136\" fill=\"#dce7f0\" font-family=\"Noto Sans,sans-serif\" font-size=\"10\">status</text><text x=\"81\" y=\"136\" fill=\"#dce7f0\" font-family=\"Noto Sans,sans-serif\" font-size=\"10\">history</text><text x=\"143\" y=\"136\" fill=\"#dce7f0\" font-family=\"Noto Sans,sans-serif\" font-size=\"10\">usage</text>\n</svg>\n"); }
if (!file_exists("assets/quickrun-d64deadbcca91574.svg")) { write_file_exclusive("assets/quickrun-d64deadbcca91574.svg", "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"240\" height=\"150\" viewBox=\"0 0 240 150\" role=\"img\" aria-labelledby=\"t d\">\n  <title id=\"t\">Automated agent workflow</title><desc id=\"d\">A workflow script sends work through authoring, acceptance checks and independent review, then loops back when needed.</desc>\n  <rect id=\"svg-auto\" x=\"5\" y=\"5\" width=\"230\" height=\"140\" rx=\"14\" fill=\"#152438\" fill-opacity=\".9\" stroke=\"#526a7e\" stroke-width=\"2\"/>\n  <rect x=\"17\" y=\"27\" width=\"62\" height=\"32\" rx=\"8\" fill=\"#31475c\" stroke=\"#72c6bd\"/><text x=\"48\" y=\"47\" text-anchor=\"middle\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"11\" font-weight=\"700\">SCRIPT</text>\n  <path d=\"M80 43h14m57 0h17\" fill=\"none\" stroke=\"#f5c16c\" stroke-width=\"3\" stroke-linecap=\"round\"/><path d=\"m88 37 7 6-7 6m71-12 7 6-7 6\" fill=\"none\" stroke=\"#f5c16c\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  <rect x=\"94\" y=\"27\" width=\"57\" height=\"32\" rx=\"7\" fill=\"#31475c\" stroke=\"#72c6bd\"/><text x=\"122\" y=\"47\" text-anchor=\"middle\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"8\" font-weight=\"700\">CODE + QA</text>\n  <rect x=\"168\" y=\"27\" width=\"55\" height=\"32\" rx=\"7\" fill=\"#31475c\" stroke=\"#f5c16c\"/><text x=\"195\" y=\"47\" text-anchor=\"middle\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"8\" font-weight=\"700\">VERDICT</text>\n  <circle cx=\"201\" cy=\"80\" r=\"10\" fill=\"#f5c16c\"/><circle cx=\"201\" cy=\"77\" r=\"2.8\" fill=\"#152438\"/><path d=\"M196 86c1-5 9-5 10 0\" fill=\"none\" stroke=\"#152438\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n  <path d=\"M218 66v40H43V68\" fill=\"none\" stroke=\"#72c6bd\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"m36 78 7-8 7 8\" fill=\"none\" stroke=\"#72c6bd\" stroke-width=\"3\"/>\n  <text x=\"120\" y=\"122\" text-anchor=\"middle\" fill=\"#f5f8fb\" font-family=\"Noto Sans,sans-serif\" font-size=\"10\" font-weight=\"700\">REPEATABLE STEPS</text><text x=\"120\" y=\"137\" text-anchor=\"middle\" fill=\"#f5c16c\" font-family=\"Noto Sans,sans-serif\" font-size=\"10\" font-weight=\"700\">CHECKED OUTPUT</text>\n</svg>\n"); }
if (!file_exists("assets/quickrun-e86a49ea3059574a.svg")) { write_file_exclusive("assets/quickrun-e86a49ea3059574a.svg", "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"960\" height=\"360\" viewBox=\"0 0 960 360\" role=\"img\" aria-labelledby=\"title desc\">\n  <title id=\"title\">Four rising levels of agent automation</title>\n  <desc id=\"desc\">A staircase rises from naming sessions to automating a workflow. Your role moves from every turn to briefing the team and reviewing its result.</desc>\n  <rect x=\"7\" y=\"7\" width=\"946\" height=\"346\" rx=\"20\" fill=\"#152438\" stroke=\"#526a7e\"/>\n  <path d=\"M70 258H108V250H110 M270 250H285V223H300 M460 223H475V190H490 M650 190H665V160H680 M840 160H860V52H896\" fill=\"none\" stroke=\"#f5c16c\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n  <circle cx=\"51\" cy=\"258\" r=\"19\" fill=\"#f5c16c\" stroke=\"#152438\" stroke-width=\"3\"/><circle cx=\"51\" cy=\"253\" r=\"5\" fill=\"#152438\"/><path d=\"M41 270c2-9 18-9 20 0\" fill=\"none\" stroke=\"#152438\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n  <text x=\"50\" y=\"294\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">You start</text>\n  <g><rect id=\"level-one-stage\" x=\"110\" y=\"185\" width=\"160\" height=\"130\" rx=\"13\" fill=\"#31475c\" fill-opacity=\".88\" stroke=\"#6fbdb4\" stroke-width=\"2\"/><text x=\"127\" y=\"211\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">LEVEL 1</text><text x=\"190\" y=\"241\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"20px\" font-weight=\"700\" fill=\"#f5f8fb\">Know sessions</text><text x=\"190\" y=\"268\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">You: every turn</text><path d=\"M162 291h56m-56 8h34\" stroke=\"#f5c16c\" stroke-width=\"5\" stroke-linecap=\"round\"/></g>\n  <g><rect x=\"300\" y=\"150\" width=\"160\" height=\"130\" rx=\"13\" fill=\"#31475c\" fill-opacity=\".88\" stroke=\"#6fbdb4\" stroke-width=\"2\"/><text x=\"317\" y=\"176\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">LEVEL 2</text><text x=\"380\" y=\"206\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"20px\" font-weight=\"700\" fill=\"#f5f8fb\">Coordinate</text><text x=\"380\" y=\"233\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">You: in the loop</text><circle cx=\"354\" cy=\"257\" r=\"6\" fill=\"#89d5cb\"/><circle cx=\"380\" cy=\"257\" r=\"6\" fill=\"#f5c16c\"/><circle cx=\"406\" cy=\"257\" r=\"6\" fill=\"#8aa8ed\"/></g>\n  <g><rect x=\"490\" y=\"115\" width=\"160\" height=\"150\" rx=\"13\" fill=\"#31475c\" fill-opacity=\".88\" stroke=\"#6fbdb4\" stroke-width=\"2\"/><text x=\"507\" y=\"141\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">LEVEL 3</text><text x=\"570\" y=\"171\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"20px\" font-weight=\"700\" fill=\"#f5f8fb\">Delegate</text><text x=\"570\" y=\"198\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">You: start</text><text x=\"570\" y=\"218\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">and end</text><path d=\"M538 240h64m-12-9 12 9-12 9\" fill=\"none\" stroke=\"#f5c16c\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g>\n  <g><rect x=\"680\" y=\"80\" width=\"160\" height=\"160\" rx=\"13\" fill=\"#31475c\" fill-opacity=\".88\" stroke=\"#6fbdb4\" stroke-width=\"2\"/><text x=\"697\" y=\"106\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">LEVEL 4</text><text x=\"760\" y=\"136\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"20px\" font-weight=\"700\" fill=\"#f5f8fb\">Automate</text><text x=\"760\" y=\"163\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">You: brainstorm</text><text x=\"760\" y=\"183\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">and verdict</text><path d=\"M728 220h64m-48-8v8m32-8v8\" fill=\"none\" stroke=\"#f5c16c\" stroke-width=\"3\" stroke-linecap=\"round\"/></g>\n  <circle cx=\"910\" cy=\"52\" r=\"19\" fill=\"#f5c16c\" stroke=\"#152438\" stroke-width=\"3\"/><circle cx=\"910\" cy=\"47\" r=\"5\" fill=\"#152438\"/><path d=\"M900 64c2-9 18-9 20 0\" fill=\"none\" stroke=\"#152438\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n  <text x=\"914\" y=\"94\" text-anchor=\"middle\" font-family=\"Noto Sans, sans-serif\" font-size=\"16px\" font-weight=\"600\" fill=\"#dce7f0\">You review</text>\n</svg>\n"); }
p = _lmcode_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
let stage = scene.load_svg("assets/quickrun-e86a49ea3059574a.svg", "level-one-stage");
let stage_again = scene.load_svg("assets/quickrun-e86a49ea3059574a.svg", "level-one-stage");
stage.set_attr("opacity", "0.99");
stage_again.set_attr("opacity", "1.0");
scene.render_png("build/rendered/svg-automation-ladder.png", 960, 360, 1);
scene.load_svg("assets/quickrun-0e2232fcea9f2111.svg", "svg-mobile");
scene.render_png("build/rendered/svg-automation-ladder-mobile.png", 720, 640, 1);
scene.load_svg("assets/quickrun-d64deadbcca91574.svg", "svg-auto");
scene.render_png("build/rendered/svg-level-automation.png", 480, 300, 1);
scene.load_svg("assets/quickrun-82367c8317669db3.svg", "svg-delegate");
scene.render_png("build/rendered/svg-level-delegate.png", 480, 300, 1);
scene.load_svg("assets/quickrun-b9aabc71d76d0334.svg", "svg-sessions");
scene.render_png("build/rendered/svg-level-sessions.png", 480, 300, 1);
scene.load_svg("assets/quickrun-6df1a5bc02229890.svg", "svg-team");
scene.render_png("build/rendered/svg-level-team.png", 480, 300, 1);
end _lmcode_
savedsl(p, out);
println("wrote six SVG renders");

run = system ${dsl_cli(p)} --lmcode ${out};
if (run.code != 0) { println(str(run.stderr)); lm_exit(run.code); }
