# lmscript icon: curly braces built from boxes around three lines of code.
# Usage (see README.md): lmscript lmscript.lms OUT_DIR OUT.dslb, then lmcad --dsl OUT.dslb
out = ARGV.get(0, "build");
p = _dsl_ schema="lmcad.dsl.json";
# --- shared icon look: identical in every icon script (render.sh --check verifies) ---
scene.background(0.17, 0.20, 0.27);
scene.directional_light(-0.5, -1.0, -0.6, 0.85);
scene.fill_light(0.8, -0.2, 0.9, 0.40);
scene.ambient(0.32);
scene.supersample(4);
let view_x = 0.36;
let view_y = 0.38;
let view_z = 0.85;
# --- end shared icon look ---
let brace = material().color(0.20, 0.82, 0.70).roughness(0.5);
let line = material().color(0.92, 0.95, 1.00).roughness(0.6);
# Two braces, side -1 is "{" and side +1 is "}". Each is one extruded
# outline: a cusp nub (two quarter circles) in the middle, straight runs, and
# quarter-circle hooks at the ends, sampled in a loop. The right edge is
# walked top to bottom, the left edge back up; x(y) is a function of y, so
# the outline never crosses itself.
let n = 40;
let half = 1.5;
let thick = 0.34;
let rn = 0.30;
let rc = 0.42;
for (k in range(0, 2)) {
  let side = float(k * 2 - 1);
  let base = side * 1.45;
  let sk = scene.sketch();
  for (edge in range(0, 2)) {
    for (i in range(0, n + 1)) {
      let s = float(i) / float(n);
      let off = thick / 2.0;
      if (edge == 1) {
        s = 1.0 - s;
        off = 0.0 - off;
      }
      let y = half - 2.0 * half * s;
      let dn = clamp(rn - abs(y), 0.0, rn);
      let nub = rn - sqrt(rn * rn - dn * dn);
      let dc = clamp(abs(y) - (half - rc), 0.0, rc * 0.97);
      let curl = rc - sqrt(rc * rc - dc * dc);
      sk.point(base + side * (nub - curl) + off, y);
    }
  }
  sk.close();
  scene.extrude(sk, 0.4, brace).position(0.0, 0.0, -0.2);
}
# Three code lines of different lengths, left-aligned like a block body,
# the block centered between the braces.
for (i in range(0, 3)) {
  let len = 1.5 - float(i % 2) * 0.6;
  let y = 0.62 - float(i) * 0.62;
  scene.box(len, 0.30, 0.3, line).position(-0.75 + len / 2.0, y, 0.0);
}
let aim_x = 0.085;
let dist = 9.66;
let icon_zoom = 0.845;
let aim_y = 0.027;
# Logo: comfortable margins. Favicon sizes: the same view moved closer
# (icon_zoom) so the symbol fills the 64/32/16 px tile.
scene.camera(28.0, aim_x + view_x * dist, aim_y + view_y * dist, view_z * dist, aim_x, aim_y, 0.0);
scene.render_png(${out} + "/logo.png", 256, 256);
let near = dist * icon_zoom;
scene.camera(28.0, aim_x + view_x * near, aim_y + view_y * near, view_z * near, aim_x, aim_y, 0.0);
scene.render_png(${out} + "/icon.png", 64, 64);
scene.render_png(${out} + "/icon-32.png", 32, 32);
scene.render_png(${out} + "/icon-16.png", 16, 16);
end _dsl_
savedsl(p, ARGV.get(1, "icon.dslb"));
