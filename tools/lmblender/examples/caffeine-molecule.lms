scene.render_png("images/caffeine-molecule.png", 32, 900, 600);
end _lmcode_
savedsl(p, out);
argv = dsl_cli(p);
push(argv, "--lmcode");
push(argv, out);
r = system(argv, 240000);
if (r.code != 0) { println(trim(r.stdout)); println(trim(r.stderr)); }
assert(r.code == 0);
println("wrote images/caffeine-molecule.png");

run = system ${dsl_cli(p)} --lmcode ${out};
if (run.code != 0) { println(str(run.stderr)); lm_exit(run.code); }
