// seed.lms -- create real provider sessions for a teamfile.
//   lmctl script seed.lms request.json
//
// { "teamfile": "./backend.lmctl" }
//
// Safe to edit: everything. This is a sample, not a service -- reshape it for the job.

// read the request form
if (len(args) < 1) { println("usage: lmctl script seed.lms <request.json>"); lm_exit(2); }
if (!file_exists(args[0])) { lm_error("no request form at " + args[0]); lm_exit(2); }
req = json_parse_safe(read_file(args[0]), null);
if (req == null) { lm_error(args[0] + " is not valid JSON"); lm_exit(2); }
teamfile = get(req, "teamfile", "");

// count sessions already there, so we can tell how many are new
before = split(read_file(teamfile), "\n");
already = 0;
for (i = 0; i < len(before); i = i + 1) {
  if (starts_with(trim(before[i]), "_MEMBER_") && contains(before[i], "sessionid=")) { already = already + 1; }
}

// run lmctl seed -- this calls each provider for real
r = system(["lmctl", "seed", teamfile], 0);
if (get(r, "code", 1) != 0) {
  lm_error("seed failed: " + trim(get(r, "stdout", "") + get(r, "stderr", "")));
  lm_exit(70);
}

// confirm by reading the file back, not just trusting the exit code
after = split(read_file(teamfile), "\n");
now = 0;
for (i = 0; i < len(after); i = i + 1) {
  if (starts_with(trim(after[i]), "_MEMBER_") && contains(after[i], "sessionid=")) { now = now + 1; }
}
if (now == 0) { lm_error("seed exited 0 but no member has a sessionid"); lm_exit(70); }
println(str(now) + " member(s) carry a sessionid (" + str(now - already) + " newly seeded)");
