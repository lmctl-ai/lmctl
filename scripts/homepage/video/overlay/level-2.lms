out = ARGV[0];
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(1280, 720, "#00000000");
let gold = "#f5c16c";
let paper = "#f5f8fb";
let bar = scene.rect(36.0, 28.0, 1208.0, 112.0, "#091625E8");
scene.rect(36.0, 28.0, 9.0, 112.0, gold);
scene.text(72.0, 106.0, 44.0, "Agents talk to each other", paper);
let badge = scene.rect(1050.0, 54.0, 160.0, 56.0, "#263d54E8"); badge.set_attr("rx", "14");
let badge_text = scene.text(1068.0, 94.0, 34.0, "LEVEL 2", gold); badge_text.set_attr("font-weight", "700");
let claude_box = scene.rect(40.0, 410.0, 200.0, 58.0, "#091625E8"); claude_box.set_attr("rx", "14");
let claude = scene.text(56.0, 451.0, 38.0, "CLAUDE", "#74d8cf"); claude.set_attr("font-weight", "700");
let codex_box = scene.rect(170.0, 230.0, 210.0, 58.0, "#091625E8"); codex_box.set_attr("rx", "14");
let codex = scene.text(186.0, 271.0, 38.0, "CODEX", "#75a9ff"); codex.set_attr("font-weight", "700");
let qwen_box = scene.rect(910.0, 230.0, 210.0, 58.0, "#091625E8"); qwen_box.set_attr("rx", "14");
let qwen = scene.text(926.0, 271.0, 38.0, "QWEN", "#c4a6ff"); qwen.set_attr("font-weight", "700");
let copilot_box = scene.rect(1060.0, 410.0, 210.0, 58.0, "#091625E8"); copilot_box.set_attr("rx", "14");
let copilot = scene.text(1076.0, 451.0, 38.0, "COPILOT", "#ff997c"); copilot.set_attr("font-weight", "700");
let open_box = scene.rect(990.0, 560.0, 260.0, 58.0, "#091625E8"); open_box.set_attr("rx", "14");
let open = scene.text(1006.0, 601.0, 38.0, "OPENCODE", "#75a9ff"); open.set_attr("font-weight", "700");
let anti_box = scene.rect(70.0, 560.0, 260.0, 58.0, "#091625E8"); anti_box.set_attr("rx", "14");
let anti = scene.text(86.0, 601.0, 36.0, "ANTIGRAVITY", "#74d8cf"); anti.set_attr("font-weight", "700");
let lead_box = scene.rect(548.0, 530.0, 182.0, 56.0, "#091625E8"); lead_box.set_attr("rx", "14");
let lead_text = scene.text(578.0, 570.0, 34.0, "LEAD", gold); lead_text.set_attr("font-weight", "700");
let relay_box = scene.rect(420.0, 160.0, 440.0, 64.0, "#091625E8"); relay_box.set_attr("rx", "14");
let relay = scene.text(456.0, 204.0, 38.0, "NO COPY-PASTE", paper); relay.set_attr("font-weight", "700");
for (i in range(0, 240)) {
  let opacity = "1";
  if (i < 24) { opacity = "0"; }
  relay_box.set_attr("opacity", opacity); relay.set_attr("opacity", opacity);
  scene.render_png("build/rendered/overlay-" + str(i) + ".png", 1280, 720, 1);
}
end _dsl_
savedsl(p, out);
