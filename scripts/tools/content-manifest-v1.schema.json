{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmctl.com/tools/schema/content-manifest-v1.json",
  "title": "lmctl tool content manifest, version 1",
  "description": "Content only: what the examples are, never how pages look. Lives in the tool repo at examples/manifest.json. Presentation (HTML, CSS, layout, paths of generated pages) belongs to lmctl-ai/lmctl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tool", "repository", "title", "description", "licence", "examples"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "tool": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "repository": {"type": "string", "pattern": "^https://github\\.com/lmctl-ai/[a-z][a-z0-9-]*$"},
    "title": {"$ref": "#/$defs/text"},
    "description": {"$ref": "#/$defs/text"},
    "licence": {"enum": ["MIT"]},
    "examples": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/example"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "description", "script", "script_sha256", "image", "image_sha256", "alt", "licence"],
      "properties": {
        "slug": {"$ref": "#/$defs/slug"},
        "title": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "script": {"type": "string", "pattern": "^examples/[a-z][a-z0-9]*(-[a-z0-9]+)*\\.lms$"},
        "script_sha256": {"$ref": "#/$defs/sha256"},
        "image": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.png$"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "alt": {"$ref": "#/$defs/text"},
        "stdout": {"$ref": "#/$defs/text"},
        "licence": {"enum": ["MIT"]},
        "kind": {"enum": ["image", "video", "text", "interactive"]},
        "featured": {"type": "boolean"},
        "tags": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/slug"}},
        "captured_with": {"type": "string", "pattern": "^[a-z][a-z0-9-]* [0-9][0-9A-Za-z.+-]*$"}
      }
    }
  }
}
