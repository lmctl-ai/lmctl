out = ARGV[0];
p = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
let frame_count = 240;
let render_width = 480;
let render_height = 270;
let blue = material().color(0.18, 0.60, 0.94).specular(0.18).shininess(22.0);
let teal = material().color(0.14, 0.78, 0.68).specular(0.20).shininess(24.0);
let gold = material().color(0.98, 0.68, 0.20).specular(0.22).shininess(26.0);
let violet = material().color(0.62, 0.45, 0.94).specular(0.18).shininess(22.0);
let message_period = 80;
let coral = material().color(0.96, 0.38, 0.28).specular(0.18).shininess(22.0);
let packet = material().color(1.0, 0.94, 0.72).specular(0.40).shininess(32.0);

# Shared look block: keep identical in all four homepage storyboards.
scene.background(0.035, 0.055, 0.10);
scene.directional_light(-0.55, -1.0, -0.45, 0.82);
scene.fill_light(0.7, -0.15, 0.8, 0.28);
scene.ambient(0.19);
scene.supersample(1);

# Provider-colored agents orbit the gold Lead; no words are modeled in 3D.
let lead = scene.sphere(0.88, gold).position(0.0, 0.0, 0.0);
let lead_flash = scene.sphere(1.05, gold).position(0.0, 0.0, 0.0).visible(false);
let a0 = scene.sphere(0.62, blue).position(-5.2, 0.0, 0.0);
let a1 = scene.sphere(0.62, teal).position(-2.6, 3.3, 0.0);
let a2 = scene.sphere(0.62, violet).position(2.6, 3.3, 0.0);
let a3 = scene.sphere(0.62, coral).position(5.2, 0.0, 0.0);
let a4 = scene.sphere(0.62, blue).position(2.6, -3.3, 0.0);
let a5 = scene.sphere(0.62, teal).position(-2.6, -3.3, 0.0);

# Thin spokes show the Lead as the team's message relay.
let spoke0 = scene.box(4.4, 0.08, 0.12, blue).position(-2.9, 0.0, -0.65);
let spoke1 = scene.box(3.5, 0.08, 0.12, teal).position(-1.35, 1.7, -0.65).rotate(0.0, 0.0, -0.65);
let spoke2 = scene.box(3.5, 0.08, 0.12, violet).position(1.35, 1.7, -0.65).rotate(0.0, 0.0, 0.65);
let spoke3 = scene.box(4.4, 0.08, 0.12, coral).position(2.9, 0.0, -0.65);
let spoke4 = scene.box(3.5, 0.08, 0.12, blue).position(1.35, -1.7, -0.65).rotate(0.0, 0.0, -0.65);
let spoke5 = scene.box(3.5, 0.08, 0.12, teal).position(-1.35, -1.7, -0.65).rotate(0.0, 0.0, 0.65);

# Small gold particles travel from one member to the Lead and then onward.
let m0 = scene.sphere(0.28, packet);
let m1 = scene.sphere(0.28, packet);
let m2 = scene.sphere(0.28, packet);
let camera = scene.camera(42.0, 0.0, 0.0, 16.0, 0.0, 0.0, 0.0);
for (frame in range(0, frame_count)) {
  let cycle0 = float(frame % message_period) / float(message_period - 1);
  let cycle1 = float((frame + 27) % message_period) / float(message_period - 1);
  let cycle2 = float((frame + 53) % message_period) / float(message_period - 1);
  let pulse0 = cycle0 > 0.42 && cycle0 < 0.58;
  let pulse1 = cycle1 > 0.42 && cycle1 < 0.58;
  let pulse2 = cycle2 > 0.42 && cycle2 < 0.58;
  let lead_pulse = pulse0 || pulse1 || pulse2;
  lead.visible(!lead_pulse);
  lead_flash.visible(lead_pulse);
  if (cycle0 < 0.5) {
    let u = ease(cycle0 * 2.0);
    m0.position(lerp(-5.2, 0.0, u), 0.0, 0.9);
  } else {
    let u = ease((cycle0 - 0.5) * 2.0);
    m0.position(lerp(0.0, 5.2, u), 0.0, 0.9);
  }
  if (cycle1 < 0.5) {
    let u = ease(cycle1 * 2.0);
    m1.position(lerp(-2.6, 0.0, u), lerp(3.3, 0.0, u), 1.0);
  } else {
    let u = ease((cycle1 - 0.5) * 2.0);
    m1.position(lerp(0.0, 2.6, u), lerp(0.0, -3.3, u), 1.0);
  }
  if (cycle2 < 0.5) {
    let u = ease(cycle2 * 2.0);
    m2.position(lerp(5.2, 0.0, u), 0.0, 1.1);
  } else {
    let u = ease((cycle2 - 0.5) * 2.0);
    m2.position(lerp(0.0, -2.6, u), lerp(0.0, 3.3, u), 1.1);
  }
  scene.render_png("frames/level-2/frame-" + str(frame) + ".png", render_width, render_height);
}
end _lmcode_
savedsl(p, out);
