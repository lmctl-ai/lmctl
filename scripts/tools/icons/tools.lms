# Site icon for /tools/: a 2x2 grid of rounded blocks in the four tool colors.
# Usage (see README.md): lmscript tools.lms OUT_DIR OUT.dslb, then lmcad --lmcode OUT.dslb
out = ARGV.get(0, "build");
p = _lmcode_ cli="lmcad" install="github:lmctl-ai/lmcad@latest";
# --- shared icon look: identical in every icon script (render.sh --check verifies) ---
scene.background(0.17, 0.20, 0.27);
scene.directional_light(-0.5, -1.0, -0.6, 0.85);
scene.fill_light(0.8, -0.2, 0.9, 0.40);
scene.ambient(0.32);
scene.supersample(4);
let view_x = 0.36;
let view_y = 0.38;
let view_z = 0.85;
# --- end shared icon look ---
# Tool colors in grid order: lmcad, lmscript, lmhtml, lmcode-cpp.
for (i in range(0, 4)) {
  let m = material().color(0.30, 0.62, 1.00).roughness(0.5);
  if (i == 1) {
    m = material().color(0.20, 0.82, 0.70).roughness(0.5);
  } else if (i == 2) {
    m = material().color(1.00, 0.48, 0.26).roughness(0.5);
  } else if (i == 3) {
    m = material().color(0.74, 0.62, 1.00).roughness(0.5);
  }
  let x = float(i % 2) * 1.5 - 0.75;
  let z = float(i / 2) * 1.5 - 0.75;
  # Back row taller than the front row so all four blocks stay visible.
  let h = 0.6;
  if (i < 2) {
    h = 1.3;
  }
  let block = scene.box(1.1, h, 1.1, m).position(x, h / 2.0, z);
  block.fillet(0.12);
}
let aim_x = -0.093;
let dist = 9.05;
let icon_zoom = 0.845;
let aim_y = 0.477;
# Logo: comfortable margins. Favicon sizes: the same view moved closer
# (icon_zoom) so the symbol fills the 64/32/16 px tile.
scene.camera(28.0, aim_x + view_x * dist, aim_y + view_y * dist, view_z * dist, aim_x, aim_y, 0.0);
scene.render_png(${out} + "/logo.png", 256, 256);
let near = dist * icon_zoom;
scene.camera(28.0, aim_x + view_x * near, aim_y + view_y * near, view_z * near, aim_x, aim_y, 0.0);
scene.render_png(${out} + "/icon.png", 64, 64);
scene.render_png(${out} + "/icon-32.png", 32, 32);
scene.render_png(${out} + "/icon-16.png", 16, 16);
end _lmcode_
savedsl(p, ARGV.get(1, "icon.dslb"));
