# Web view: write decorated copies of the notes in DIR to OUT. The sources are
# only read; presentation (viewport, stylesheet, nav, main, footer) exists only
# in the copies. Order and prev/next follow the generated index list.
# ARGV: bytecode output, report output, DIR, OUT, stylesheet URL.
dir = ARGV[2];
out = ARGV[3];
css = ARGV[4];
require(file_exists(dir + "/index.html"), "web view needs DIR/index.html; run scripts/memory/run.sh index DIR");
order = ["index.html"];
for (path in sort(glob(dir + "/*.html"))) {
  if (basename(path) != "index.html") { push(order, basename(path)); }
}
for (path in sort(glob(dir + "/archive/*.html"))) { push(order, "archive/" + basename(path)); }
existing = "";
for (rel in order) {
  if (file_exists(out + "/" + rel)) { existing = existing + rel + "|"; }
}
pages = join(order, "|") + "|";

p = _dsl_ schema="lmhtml.dsl.json";
fn escape(text: string) -> string {
  return str_replace(str_replace(str_replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;");
}
fn title_of(path: string) -> string {
  let text = html.load(path).select("title").at(0).text();
  return str_trim(str_replace(text, "\n", " "));
}
fn up(rel: string) -> string {
  let prefix = "";
  if (str_starts_with(rel, "archive/")) { prefix = "../"; }
  return prefix;
}
fn href(from: string, to: string) -> string {
  let target = to;
  if (str_starts_with(from, "archive/") && str_starts_with(to, "archive/")) { target = str_substr(to, 8, str_len(to)); }
  else { target = up(from) + to; }
  return target;
}

let base = ${dir};
let target = ${out};
let stylesheet = ${css};
let done = ${existing};
let rest = ${pages};
let previous = "";
while (str_find(rest, "|") >= 0) {
  let rel = str_substr(rest, 0, str_find(rest, "|"));
  rest = str_substr(rest, str_find(rest, "|") + 1, str_len(rest));
  let next = "";
  if (str_find(rest, "|") >= 0) { next = str_substr(rest, 0, str_find(rest, "|")); }
  let source = html.load(base + "/" + rel).source();
  let head_end = str_find(source, "</head>");
  let body_start = str_find(source, "<body>");
  let body_end = str_find(source, "</body>");
  if (head_end < 0 || body_start < 0 || body_end < body_start) {
    report.add("memory", base + "/" + rel, 0, "web: needs explicit </head>, <body> and </body>; run scripts/memory/run.sh check " + base);
  } else {
    let nav = "<nav>\n<ul>\n<li><a href=\"" + href(rel, "index.html") + "\">Index</a></li>\n";
    if (previous != "") { nav = nav + "<li><a href=\"" + href(rel, previous) + "\">Previous: " + escape(title_of(base + "/" + previous)) + "</a></li>\n"; }
    if (next != "") { nav = nav + "<li><a href=\"" + href(rel, next) + "\">Next: " + escape(title_of(base + "/" + next)) + "</a></li>\n"; }
    nav = nav + "</ul>\n</nav>\n<main>";
    let footer = "</main>\n<footer>\n<p>Web view of " + escape(base + "/" + rel) + ". The note itself is content-only HTML; this copy adds the stylesheet and navigation.</p>\n</footer>\n";
    let page = str_substr(source, 0, head_end)
      + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"stylesheet\" href=\"" + stylesheet + "\">\n"
      + str_substr(source, head_end, body_start + 6 - head_end)
      + "\n" + nav
      + str_substr(source, body_start + 6, body_end - body_start - 6)
      + footer
      + str_substr(source, body_end, str_len(source));
    let path = target + "/" + rel;
    let unchanged = false;
    if (str_contains(done, "|" + rel + "|") || str_starts_with(done, rel + "|")) {
      unchanged = html.load(path).source() == page;
    }
    if (!unchanged) { html.save(page, path); }
  }
  previous = rel;
}
report.write_text(${ARGV[1]});
report.fail_if_any();
end _dsl_
savedsl(p, ARGV[0]);
