scene.ground_plane(0.0, 80.0, 0.20, 0.23, 0.28);
scene.world_color(0.35, 0.42, 0.55, 0.5);
scene.area_light(-6.0, -7.0, 10.0, 0.0, 0.0, 2.0, 1.0, 0.92, 0.82, 1500.0, 6.0);
scene.area_light(8.0, -2.0, 6.0, 0.0, 0.0, 2.0, 0.6, 0.75, 1.0, 700.0, 5.0);
scene.camera_look_at(0.6, -9.5, 9.0, 0.3, -0.2, 1.8, 40.0);
